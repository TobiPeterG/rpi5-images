#!/usr/bin/python3
"""Generate a per-build test key and hand its paths back to mkosi."""

import json
import os
from pathlib import Path
import subprocess
import sys


config = json.load(sys.stdin)
source = Path(config["BuildSources"][0]["Source"])
private_host = source / ".mkosi-private"
private_build = Path("/work/src/.mkosi-private")
key_build = private_build / "test-secure-boot.key"
cert_build = private_build / "test-secure-boot.crt"

private_build.mkdir(mode=0o700, exist_ok=True)
if not key_build.exists() or not cert_build.exists():
    key_tmp = key_build.with_suffix(".key.new")
    cert_tmp = cert_build.with_suffix(".crt.new")
    subprocess.run(
        [
            "openssl", "req", "-x509", "-newkey", "rsa:3072", "-sha256",
            "-nodes", "-days", "30", "-subj",
            "/CN=Raspberry Pi MicroOS ephemeral build key/",
            "-keyout", str(key_tmp), "-out", str(cert_tmp),
        ],
        check=True,
        env={**os.environ, "OPENSSL_CONF": "/dev/null"},
    )
    key_tmp.chmod(0o600)
    cert_tmp.chmod(0o644)
    key_tmp.replace(key_build)
    cert_tmp.replace(cert_build)

config["SecureBootKey"] = str(private_host / key_build.name)
config["SecureBootCertificate"] = str(private_host / cert_build.name)
json.dump(config, sys.stdout)

