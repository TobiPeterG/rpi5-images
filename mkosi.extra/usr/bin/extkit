#!/usr/bin/python3
"""Inspect live changes and build systemd extensions."""

import argparse
import base64
import configparser
from contextlib import contextmanager
from datetime import datetime, timezone
import difflib
import fnmatch
from functools import wraps
import fcntl
import glob
import hashlib
import importlib.util
import json
import os
import re
import secrets
import shutil
import stat
import struct
import subprocess
import sys
import tempfile
import zipfile
import uuid
import zlib
from types import SimpleNamespace
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib/extkit"))
from common import print, load_path_list, save_path_list, locked_state, verification_environment
from common import enrolled_certificates
import addons

STATE = None
ROOT = None
BASE_DIRECTORY = None
BASE_DEVICE = None
BASE_FSTYPE = None
OVERLAY_UPPERS = []
RUNTIME_DIRECTORY = None
ENABLED_DIRS = {}
RUNTIME_DIRS = {}
EROFS_TOOL = None
EROFS_FSCK_TOOL = None
PHONE_TOOL = None
REPART_TOOL = None
BOOT_SETTINGS = None
ADDON_SETTINGS = {}
KINDS = {}
NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9.-]*\Z")
EXCLUDED_TREES = ()
UPDATE_POLICIES = ("persistent", "current", "any")
BLOCK_SIZE = 4096


DIGEST_SIZE = 32
HASHES_PER_BLOCK = BLOCK_SIZE // DIGEST_SIZE


def state_transaction(function):
    @wraps(function)
    def transaction(*args, **kwargs):
        # Resolve a shell-expanded '*' before creating STATE changes the cwd's
        # directory listing used to recognize that expansion.
        if function.__name__ in ("command_stage", "command_unstage"):
            args[0].paths = normalize_shell_glob(args[0].paths)
        with locked_state(STATE):
            return function(*args, **kwargs)
    return transaction


def configure(path):
    global STATE, ROOT, BASE_DIRECTORY, BASE_DEVICE, BASE_FSTYPE, OVERLAY_UPPERS
    global RUNTIME_DIRECTORY, ENABLED_DIRS, RUNTIME_DIRS, EROFS_TOOL, EROFS_FSCK_TOOL
    global KINDS, EXCLUDED_TREES, PHONE_TOOL, REPART_TOOL
    global BOOT_SETTINGS, ADDON_SETTINGS
    config = configparser.ConfigParser(interpolation=None)
    if not config.read(path):
        fail(f"configuration file not found: {path}")
    paths = config["Paths"]
    BOOT_SETTINGS = dict(config["BootUpdates"]) if config.has_section("BootUpdates") else None
    ADDON_SETTINGS = dict(config["Addons"]) if config.has_section("Addons") else {}
    STATE = Path(paths["StateDirectory"])
    ROOT = Path(paths["RootDirectory"])
    OVERLAY_UPPERS = []
    for line in paths.get("OverlayUpperDirectories", "").splitlines():
        if not line.strip():
            continue
        fields = line.split()
        if len(fields) != 2:
            fail(f"expected 'UPPERDIR ROOT-PREFIX' in OverlayUpperDirectories: {line!r}")
        upper, prefix = map(Path, fields)
        if not upper.is_absolute() or not prefix.is_absolute():
            fail(f"overlay upperdir and root prefix must be absolute: {line!r}")
        if ".." in upper.parts or ".." in prefix.parts:
            fail(f"overlay upperdir and root prefix must not contain '..': {line!r}")
        OVERLAY_UPPERS.append((upper, prefix))
    BASE_DIRECTORY = Path(paths["BaseDirectory"]) if paths.get("BaseDirectory") else None
    BASE_DEVICE = Path(paths["BaseDevice"]) if paths.get("BaseDevice") else None
    BASE_FSTYPE = paths["BaseFileSystem"]
    RUNTIME_DIRECTORY = Path(paths["RuntimeDirectory"])
    ENABLED_DIRS = {
        "sysext": Path(paths["EnabledSysextDirectory"]),
        "confext": Path(paths["EnabledConfextDirectory"]),
    }
    RUNTIME_DIRS = {
        "sysext": Path(paths.get("RuntimeSysextDirectory", "/run/extensions")),
        "confext": Path(paths.get("RuntimeConfextDirectory", "/run/confexts")),
    }
    extensions = config["Extensions"]
    KINDS = {}
    assigned_prefixes = set()
    for line in extensions.get("Kinds", "").splitlines():
        if not line.strip():
            continue
        fields = line.split()
        if len(fields) < 2:
            fail(f"expected 'TYPE PATH [PATH...]' in Kinds: {line!r}")
        kind, *prefix_values = fields
        if kind not in ENABLED_DIRS:
            fail(f"unsupported extension type in Kinds: {kind!r}")
        if kind in KINDS:
            fail(f"duplicate extension type in Kinds: {kind!r}")
        prefixes = []
        for value in prefix_values:
            prefix = Path(value)
            if not prefix.is_absolute() or ".." in prefix.parts or len(prefix.parts) != 2:
                fail(f"kind paths must be absolute top-level paths: {value!r}")
            name = prefix.parts[1]
            if name in assigned_prefixes:
                fail(f"kind path is assigned more than once: {value!r}")
            assigned_prefixes.add(name)
            prefixes.append(name)
        KINDS[kind] = tuple(prefixes)
    if not KINDS:
        fail("configure at least one Kinds entry")
    excluded = []
    for value in extensions.get("ExcludedTrees", "").splitlines():
        value = value.strip()
        if not value:
            continue
        path_value = Path(value)
        if not path_value.is_absolute() or ".." in path_value.parts:
            fail(f"excluded tree must be an absolute path: {value!r}")
        relative = path_value.relative_to("/")
        excluded.append(relative.parts)
    EXCLUDED_TREES = tuple(excluded)
    EROFS_TOOL = config["Build"]["ErofsTool"]
    EROFS_FSCK_TOOL = config["Build"].get("ErofsFsckTool", "fsck.erofs")
    PHONE_TOOL = config["Build"].get("PhoneTool", "/usr/bin/extkit-phone")
    REPART_TOOL = config["Build"].get("RepartTool", "systemd-repart")
    for name, value in (("StateDirectory", STATE), ("RootDirectory", ROOT),
                        ("RuntimeDirectory", RUNTIME_DIRECTORY),
                        *ENABLED_DIRS.items(), *RUNTIME_DIRS.items()):
        if not value.is_absolute():
            fail(f"{name} must be an absolute path: {value}")
    if not BASE_DIRECTORY and not BASE_DEVICE:
        fail("configure either BaseDirectory or BaseDevice")
    for name, value in (("BaseDirectory", BASE_DIRECTORY), ("BaseDevice", BASE_DEVICE)):
        if value is not None and not value.is_absolute():
            fail(f"{name} must be an absolute path: {value}")
    if not OVERLAY_UPPERS:
        fail("configure at least one OverlayUpperDirectories entry")


def fail(message):
    raise ValueError(message)


def checked_name(value):
    if not NAME_RE.fullmatch(value) or value in (".", ".."):
        fail(f"invalid name/version: {value!r}")
    return value


def excluded_path(relative):
    return any(relative.parts[:len(prefix)] == prefix for prefix in EXCLUDED_TREES)


def relative_path(value, kind=None):
    path = Path(value)
    if not path.is_absolute() or ".." in path.parts or len(path.parts) < 3:
        fail(f"expected an absolute file path: {value}")
    relative = path.relative_to("/")
    actual_kind = kind_for(relative)
    if kind is not None and actual_kind != kind:
        fail(f"/{relative} belongs to {actual_kind}, not {kind}")
    if relative.parts[:2] in (("usr", "lib"), ("etc", "extension-release.d")) and "extension-release.d" in relative.parts:
        fail("extension-release metadata is generated by this tool")
    if excluded_path(relative):
        fail(f"runtime or extension storage cannot be staged: /{relative}")
    return relative


def kind_for(relative):
    for kind, prefixes in KINDS.items():
        if relative.parts[0] in prefixes:
            return kind
    expected = ", ".join(f"/{prefix}" for prefixes in KINDS.values() for prefix in prefixes)
    fail(f"unsupported extension path: /{relative} (expected {expected})")


def live_file(relative):
    path = ROOT / relative
    for parent in list(path.parents)[:-1]:
        if parent == ROOT:
            break
        if parent.is_symlink():
            fail(f"symlinked parent directory is unsupported: {parent}")
    if not path.is_symlink() and not path.is_file():
        fail(f"live path is missing or has an unsupported file type: /{relative}")
    return path


def selection_file():
    return STATE / "index.json"


def load_selection():
    return load_path_list(selection_file())


def save_selection(paths):
    save_path_list(selection_file(), paths)


def deletion_file():
    return STATE / "deletions.json"


def load_deletions():
    return load_path_list(deletion_file())


def save_deletions(paths):
    save_path_list(deletion_file(), paths)


def upper_candidates(relative):
    visible = Path("/") / relative
    for upper, root_prefix in OVERLAY_UPPERS:
        try:
            suffix = visible.relative_to(root_prefix)
        except ValueError:
            continue
        yield upper / suffix


def is_whiteout(relative):
    for candidate in upper_candidates(relative):
        try:
            info = candidate.lstat()
        except FileNotFoundError:
            continue
        if stat.S_ISCHR(info.st_mode) and info.st_rdev == os.makedev(0, 0):
            return True
        if stat.S_ISREG(info.st_mode) and info.st_size == 0:
            try:
                if os.getxattr(candidate, "trusted.overlay.whiteout"):
                    return True
            except OSError:
                pass
    return False


@contextmanager
def base_tree():
    if BASE_DIRECTORY:
        if not BASE_DIRECTORY.is_dir():
            fail(f"base directory is not accessible: {BASE_DIRECTORY}")
        yield BASE_DIRECTORY
        return
    with tempfile.TemporaryDirectory(prefix="extension-base-", dir=RUNTIME_DIRECTORY) as directory:
        subprocess.run(["mount", "-t", BASE_FSTYPE, "-o", "ro,nodev,nosuid,noexec", str(BASE_DEVICE), directory], check=True)
        try:
            yield Path(directory)
        finally:
            subprocess.run(["umount", directory], check=True)


def show_diff(base, relative):
    old = base / relative
    try:
        new = live_file(relative)
    except ValueError:
        if is_whiteout(relative) and (old.exists() or old.is_symlink()):
            print(f"DELETED /{relative}")
            return
        raise
    if not old.exists() and not old.is_symlink():
        print(f"ADDED /{relative} (not present in base image)")
        return
    if old.is_symlink() or new.is_symlink():
        old_target = os.readlink(old) if old.is_symlink() else "<regular file>"
        new_target = os.readlink(new) if new.is_symlink() else "<regular file>"
        print(f"/{relative}: base symlink={old_target!r}; live symlink={new_target!r}")
        return
    old_bytes, new_bytes = old.read_bytes(), new.read_bytes()
    if old_bytes == new_bytes:
        print(f"UNCHANGED /{relative}")
    elif b"\0" in old_bytes or b"\0" in new_bytes:
        print(f"BINARY CHANGED /{relative}: {len(old_bytes)} -> {len(new_bytes)} bytes")
    else:
        before = old_bytes.decode("utf-8", "replace").splitlines(keepends=True)
        after = new_bytes.decode("utf-8", "replace").splitlines(keepends=True)
        sys.stdout.writelines(difflib.unified_diff(before, after, fromfile=f"base/{relative}", tofile=f"live/{relative}"))


def os_release():
    result = {}
    for line in (ROOT / "usr/lib/os-release").read_text().splitlines():
        if "=" in line and not line.startswith("#"):
            key, value = line.split("=", 1)
            result[key] = value.strip().strip('"')
    return result


def release_metadata(tree, name, kind, version, updates):
    release = os_release()
    level = "SYSEXT_LEVEL" if kind == "sysext" else "CONFEXT_LEVEL"
    if updates == "any":
        metadata = ["ID=_any"]
    elif updates == "persistent":
        if not release.get(level):
            fail(f"{level} is required for persistent {kind} images")
        metadata = [f"ID={release['ID']}", f"{level}={release[level]}"]
    else:
        if not release.get("VERSION_ID"):
            fail(f"VERSION_ID is required for current-system {kind} images")
        metadata = [f"ID={release['ID']}", f"VERSION_ID={release['VERSION_ID']}"]
    metadata += [
        f"IMAGE_ID={name}",
        f"IMAGE_VERSION={version}",
    ]
    location = "usr/lib" if kind == "sysext" else "etc"
    destination = tree / location / "extension-release.d" / f"extension-release.{name}"
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text("\n".join(metadata) + "\n")


def store_dir(kind):
    return STATE / "store" / kind


def enabled_dir(kind):
    return ENABLED_DIRS[kind]


def runtime_dir(kind):
    return RUNTIME_DIRS[kind]


def image_versions(kind, name):
    versions = {}
    directory = store_dir(kind)
    for image in directory.glob(f"{name}_*.raw") if directory.exists() else []:
        parsed = split_image_name(image)
        if parsed is None or parsed[0] != name:
            continue
        version = parsed[1]
        if not version.isdecimal() or int(version) < 1:
            fail(f"automatic versioning requires positive integer versions: {image}")
        versions[int(version)] = image
    return versions


def latest_image(kind, name):
    versions = image_versions(kind, name)
    return versions[max(versions)] if versions else None


def requested_images(name, version=None, kind=None):
    checked_name(name)
    if version is not None:
        checked_name(version)
    found = []
    for candidate_kind in (kind,) if kind else KINDS:
        image = (store_dir(candidate_kind) / f"{name}_{version}.raw"
                 if version is not None else latest_image(candidate_kind, name))
        if image is not None and image.is_file():
            found.append((candidate_kind, image))
    if not found:
        suffix = f" version {version}" if version is not None else ""
        fail(f"no built images found for {name}{suffix}")
    return found


@contextmanager
def image_tree(image):
    """Extract an image into a private temporary tree for inspection or inheritance."""
    work = STATE / "work"
    work.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="extkit-image-", dir=work) as directory:
        tree = Path(directory) / "tree"
        tree.mkdir()
        partitions = gpt_partitions(image)
        if not partitions or "extkit-root" not in partitions:
            fail("expected an ExtKit GPT extension image")
        subprocess.run([
            EROFS_FSCK_TOOL, f"--offset={partitions['extkit-root']['offset']}",
            f"--extract={tree}", "--overwrite", "--preserve", str(image),
        ], check=True)
        yield tree


def copy_image_tree(image, destination):
    with image_tree(image) as source:
        subprocess.run(["cp", "-a", f"{source}/.", str(destination)], check=True)


def parse_release_text(text):
    values = {}
    for line in text.splitlines():
        if "=" in line and not line.startswith("#"):
            key, value = line.split("=", 1)
            values[key] = value.strip().strip('"')
    return values


def embedded_update_policy(kind, image):
    parsed = split_image_name(image)
    if parsed is None:
        fail(f"invalid extension image name: {image}")
    name, _ = parsed
    location = "usr/lib" if kind == "sysext" else "etc"
    metadata = parse_release_text(read_image_metadata(
        image, f"{location}/extension-release.d/extension-release.{name}"))
    level = "SYSEXT_LEVEL" if kind == "sysext" else "CONFEXT_LEVEL"
    if metadata.get("ID") == "_any":
        updates = "any"
    elif level in metadata:
        updates = "persistent"
    elif "VERSION_ID" in metadata:
        updates = "current"
    else:
        fail(f"extension has no systemd compatibility policy: {image}")
    return updates, metadata.get("VERSION_ID")


def read_image_metadata(image, relative):
    """Extract release metadata"""
    partitions = gpt_partitions(image)
    if not partitions or "extkit-root" not in partitions:
        fail("expected an ExtKit GPT extension image")
    work = STATE / "work"
    work.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="extkit-metadata-", dir=work) as directory:
        metadata = Path(directory) / "release"
        subprocess.run([
            EROFS_FSCK_TOOL, f"--offset={partitions['extkit-root']['offset']}",
            f"--path=/{relative}", f"--extract={metadata}", "--no-preserve", str(image),
        ], check=True, capture_output=True, text=True)
        if metadata.is_symlink() or not metadata.is_file():
            fail("extension release metadata must be a regular file")
        with metadata.open("rb") as stream:
            data = stream.read(64 * 1024 + 1)
        if len(data) > 64 * 1024:
            fail("extension release metadata exceeds 64 KiB")
        return data.decode("utf-8")


def policy_description(updates, version_id=None):
    if updates == "persistent":
        return "persistent (systemd level compatibility)"
    if updates == "any":
        return "any system (ID=_any)"
    return f"current VERSION_ID {version_id or 'unknown'}"


def remove_path(path):
    if path.is_symlink() or (path.exists() and not path.is_dir()):
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def copy_selected(source, destination):
    remove_path(destination)
    destination.parent.mkdir(parents=True, exist_ok=True)
    if source.is_symlink():
        destination.symlink_to(os.readlink(source))
        if os.geteuid() == 0:
            os.lchown(destination, source.lstat().st_uid, source.lstat().st_gid)
    else:
        shutil.copy2(source, destination, follow_symlinks=False)
        if os.geteuid() == 0:
            shutil.chown(destination, user=source.stat().st_uid, group=source.stat().st_gid)


def changed_paths(kind=None):
    wanted = set(KINDS[kind]) if kind else {prefix for prefixes in KINDS.values() for prefix in prefixes}
    changed = set()
    accessible = False
    for upper, root_prefix in OVERLAY_UPPERS:
        if not upper.is_dir():
            continue
        accessible = True
        for directory, names, files in os.walk(upper, followlinks=False):
            for name in sorted(names + files):
                candidate = Path(directory) / name
                if candidate.is_dir() and not candidate.is_symlink():
                    continue
                visible = root_prefix / candidate.relative_to(upper)
                relative = visible.relative_to("/") if visible.is_absolute() else visible
                if relative.parts and relative.parts[0] in wanted and not excluded_path(relative):
                    changed.add("/" + str(relative))
    if not accessible:
        configured = ", ".join(str(upper) for upper, _ in OVERLAY_UPPERS)
        fail(f"no configured overlay upperdir is accessible: {configured}")
    return sorted(changed)


def staged_paths(kind=None):
    paths = set(load_selection()) | set(load_deletions())
    return sorted(path for path in paths
                  if kind is None or kind_for(relative_path(path)) == kind)


def normalize_shell_glob(patterns):
    """Recognize an unquoted '*' after the shell expanded it in the current directory."""
    expanded = glob.glob("*")
    if patterns and len(patterns) == len(expanded) and set(patterns) == set(expanded):
        return ["*"]
    return patterns


def select_paths(patterns, candidates, description):
    patterns = normalize_shell_glob(patterns)
    if not patterns or patterns == ["*"]:
        return sorted(candidates)
    selected = set()
    for value in patterns:
        if value == "*":
            selected.update(candidates)
            continue
        if value.startswith("/"):
            pattern = value
            matches = [path for path in candidates if fnmatch.fnmatchcase(path, pattern)]
        else:
            # An unquoted shell glob commonly turns '*' into top-level names such
            # as 'etc' and 'usr'. Treat relative selectors as subtrees, never as
            # paths to read directly from the running OS.
            prefix = "/" + value.strip("/")
            matches = [path for path in candidates
                       if path == prefix or path.startswith(prefix + "/")]
        selected.update(matches)
    if not selected:
        fail(f"no {description} files match: {' '.join(patterns)}")
    return sorted(selected)


def command_diff(args):
    staged = set(staged_paths(args.kind))
    show_staged = getattr(args, "staged", False)
    candidates = staged if show_staged else set(changed_paths(args.kind)) - staged
    paths = select_paths(args.paths, candidates, "staged" if show_staged else "unstaged")
    with base_tree() as base:
        for path in paths:
            try:
                show_diff(base, relative_path(path, args.kind))
            except ValueError as exc:
                print(f"Skipped {path}: {exc}", file=sys.stderr, color="yellow")


@state_transaction
def command_stage(args):
    paths = select_paths(args.paths, changed_paths(args.kind), "changed")
    deletions = set(load_deletions())
    selection = set(load_selection())
    staged = 0
    skipped = []
    for path in paths:
        relative = relative_path(path, args.kind)
        try:
            live_file(relative)
        except ValueError as exc:
            if not is_whiteout(relative):
                skipped.append((path, exc))
                continue
            deletions.add(path)
            selection.discard(path)
        else:
            selection.add(path)
            deletions.discard(path)
        staged += 1
    save_selection(selection)
    save_deletions(deletions)
    print(f"Staged {staged} path(s); {len(selection) + len(deletions)} total. Content will be read at build time", color="green")
    for path, exc in skipped:
        print(f"Skipped {path}: {exc}", file=sys.stderr, color="yellow")


@state_transaction
def command_unstage(args):
    selection = set(load_selection())
    deletions = set(load_deletions())
    for path in select_paths(args.paths, staged_paths(args.kind), "staged"):
        selection.discard(path)
        deletions.discard(path)
    save_selection(selection)
    save_deletions(deletions)
    print(f"{len(selection) + len(deletions)} staged path(s) remain")


def mounted_extensions(kind):
    environment = os.environ.copy()
    environment[f"SYSTEMD_{kind.upper()}_HIERARCHIES"] = ":".join(
        f"/{prefix}" for prefix in KINDS[kind]
    )
    try:
        result = subprocess.run(
            [f"systemd-{kind}", "status", "--json=short", "--no-pager"],
            text=True, capture_output=True, env=environment,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    try:
        rows = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None
    mounted = set()
    for row in rows:
        values = row.get("extensions", [])
        if isinstance(values, str):
            values = re.split(r"[\s,]+", values)
        for value in values:
            if value and value != "none":
                mounted.add(value)
    return mounted


def stored_extension_states(kind):
    states = []
    directory = store_dir(kind)
    for image in sorted(directory.glob("*.raw")) if directory.exists() else []:
        parsed = split_image_name(image)
        if parsed is None:
            continue
        name, _ = parsed
        link = enabled_dir(kind) / f"{name}.raw"
        selected = link.is_symlink() and link.resolve() == image.resolve()
        states.append((image, selected, link if selected else None))
    return states


def enabled_since(link):
    timestamp = link.lstat().st_mtime
    return datetime.fromtimestamp(timestamp, timezone.utc).astimezone().isoformat(timespec="seconds")


def command_status(args):
    selection = set(load_selection())
    deletions = set(load_deletions())
    changed = set(changed_paths(args.kind))
    staged = sorted(path for path in selection | deletions if args.kind is None or kind_for(relative_path(path)) == args.kind)
    print("Staged:")
    for path in staged:
        print(f"  {path}" + (" (deleted)" if path in deletions else ""))
    print("Unstaged:")
    for path in sorted(changed - selection - deletions):
        print(f"  {path}")
    print("Extensions:")
    print_quarantine(args.kind)
    for kind in KINDS:
        if args.kind is not None and kind != args.kind:
            continue
        mounted = mounted_extensions(kind)
        mounted_text = "unknown" if mounted is None else ", ".join(sorted(mounted)) or "none"
        print(f"  {kind}:")
        print(f"    mounted: {mounted_text}")
        states = stored_extension_states(kind)
        if not states:
            print("    images: none")
            continue
        print("    images:")
        for image, selected, link in states:
            name, _ = split_image_name(image)
            try:
                updates, version_id = embedded_update_policy(kind, image)
            except (OSError, ValueError, subprocess.CalledProcessError) as error:
                policy = f"unknown (metadata unreadable: {error})"
            else:
                policy = policy_description(updates, version_id)
            signature, trust, _ = signature_status(image)
            policy += f"; signature: {signature}; trust: {trust}"
            if selected:
                mounted_now = mounted is not None and name in mounted
                print(
                    f"      {image.name}: enabled since {enabled_since(link)}; "
                    f"updates: {policy}; "
                    f"mounted: {'yes' if mounted_now else 'no'}"
                )
            else:
                print(f"      {image.name}: disabled; updates: {policy}")
    if args.kind is None:
        print("UKI addons:")
        print_addon_status(indent="  ")
    if BOOT_SETTINGS is not None and args.kind is None:
        command_boot_update_check(args)


def boot_updates_module():
    path = Path(__file__).resolve().parents[1] / "lib/extkit/boot_updates.py"
    spec = importlib.util.spec_from_file_location("extkit_boot_updates", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def boot_update_paths():
    if BOOT_SETTINGS is None:
        fail("configure [BootUpdates] in extkit.conf")
    directory = Path(BOOT_SETTINGS.get("stagingdirectory", str(STATE / "boot-updates")))
    phone_config = configparser.ConfigParser(interpolation=None)
    phone_config.read(BOOT_SETTINGS.get("phoneconfiguration", "/etc/extkit-phone.conf"))
    boot = Path(phone_config.get("Network", "BootDirectory", fallback="/boot"))
    if not directory.is_absolute() or not boot.is_absolute():
        fail("boot update paths must be absolute")
    image_id = os_release().get("IMAGE_ID", "")
    if not NAME_RE.fullmatch(image_id):
        fail("IMAGE_ID missing or invalid in /usr/lib/os-release")
    return directory, boot, image_id


def command_boot_update_check(args):
    directory, boot, image_id = boot_update_paths()
    boot_updates_module().show(directory, boot, image_id, print)


def command_boot_update(args):
    directory, boot, image_id = boot_update_paths()
    def confirm(prompt):
        if not sys.stdin.isatty():
            return False
        return input(prompt).strip().lower() in ("", "y", "yes")
    boot_updates_module().sign(directory, boot, image_id,
                               PHONE_TOOL, args.version, print, confirm)


def hash_block(block, salt):
    return hashlib.sha256(salt + block).digest()


def verity_root_hash(image, data_blocks, salt, temporary_directory):
    """Compute the cryptsetup-compatible dm-verity v1/SHA-256 root hash."""
    image = Path(image)
    if image.stat().st_size != data_blocks * BLOCK_SIZE:
        raise ValueError("image size does not equal data_blocks * 4096")
    source, source_blocks, generated = image, data_blocks, []
    try:
        while source_blocks > 1:
            output_blocks = (source_blocks + HASHES_PER_BLOCK - 1) // HASHES_PER_BLOCK
            descriptor, filename = tempfile.mkstemp(prefix="verity-level-", dir=temporary_directory)
            os.close(descriptor)
            output = Path(filename)
            generated.append(output)
            with source.open("rb") as src, output.open("wb") as dst:
                remaining = source_blocks
                for _ in range(output_blocks):
                    hashes = bytearray(BLOCK_SIZE)
                    for index in range(HASHES_PER_BLOCK):
                        if not remaining:
                            break
                        block = src.read(BLOCK_SIZE)
                        if len(block) != BLOCK_SIZE:
                            raise ValueError("truncated image while calculating dm-verity")
                        start = index * DIGEST_SIZE
                        hashes[start:start + DIGEST_SIZE] = hash_block(block, salt)
                        remaining -= 1
                    dst.write(hashes)
                if remaining or src.read(1):
                    raise ValueError("image size changed while calculating dm-verity")
            source, source_blocks = output, output_blocks
        with source.open("rb") as src:
            block = src.read(BLOCK_SIZE)
            if len(block) != BLOCK_SIZE or src.read(1):
                raise ValueError("invalid final dm-verity level")
        return hash_block(block, salt).hex()
    finally:
        for path in generated:
            path.unlink(missing_ok=True)


def file_sha256(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def json_bytes(value):
    return (json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n").encode()


SIGNED_POLICY = "root=signed:usr=absent"
SIGNATURE_BYTES = 16384


def signature_status(image, verify=True):
    """Presence is distinct from acceptance by this boot's kernel keyrings."""
    try:
        partitions = gpt_partitions(image)
        if not partitions or "extkit-signature" not in partitions:
            return "unsigned", "not trusted", "no embedded signature partition"
        partition = partitions["extkit-signature"]
        if partition["size"] > SIGNATURE_BYTES:
            return "invalid", "not trusted", "oversized signature partition"
        with Path(image).open("rb") as stream:
            stream.seek(partition["offset"])
            payload = stream.read(partition["size"]).rstrip(b"\0")
        if not payload:
            return "unsigned", "not trusted", "empty signature partition"
        value = json.loads(payload)
        cms = base64.b64decode(value["signature"], validate=True)
        if not cms:
            return "unsigned", "not trusted", "empty CMS signature"
        if value.get("rootHash") != partitions["extkit-root"]["uuid"] + partitions["extkit-verity"]["uuid"]:
            return "invalid", "not trusted", "signature root hash does not match GPT"
    except (OSError, ValueError, KeyError, TypeError) as error:
        return "invalid", "not trusted", str(error)
    if not verify:
        return "signed", "unchecked", "signature present"
    if os.geteuid() != 0:
        return "signed", "unknown (run as root)", "kernel verification requires root"
    environment = verification_environment()
    try:
        result = subprocess.run(["systemd-dissect", "--read-only", f"--image-policy={SIGNED_POLICY}",
                                 "--with", str(image), "/usr/bin/true"],
                                capture_output=True, text=True, env=environment, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as error:
        return "signed", "unknown (verification unavailable)", str(error)
    if result.returncode == 0:
        return "signed", "trusted", "accepted by kernel signed-image verification"
    return "signed", "not trusted/usable", (result.stderr or "kernel verification failed").strip()


def gpt_partitions(image):
    """Read our 512-byte-sector GPT, checking bounds and CRCs before extraction."""
    with Path(image).open("rb") as stream:
        stream.seek(512)
        header = bytearray(stream.read(512))
        if header[:8] != b"EFI PART":
            return None
        if len(header) < 92:
            fail("truncated GPT header")
        header_size = struct.unpack_from("<I", header, 12)[0]
        if not 92 <= header_size <= 512:
            fail("invalid GPT header size")
        expected = struct.unpack_from("<I", header, 16)[0]
        struct.pack_into("<I", header, 16, 0)
        if zlib.crc32(header[:header_size]) != expected:
            fail("invalid GPT header checksum")
        entry_lba, count, size, checksum = struct.unpack_from("<QIII", header, 72)
        image_size = Path(image).stat().st_size
        if not 1 <= count <= 128 or size != 128 or entry_lba < 2:
            fail("unsupported GPT entry table")
        if entry_lba * 512 + count * size > image_size:
            fail("GPT entry table outside image")
        stream.seek(entry_lba * 512)
        entries = stream.read(count * size)
        if zlib.crc32(entries) != checksum:
            fail("invalid GPT partition table checksum")
        partitions = {}
        extents = []
        for index in range(count):
            entry = entries[index * size:(index + 1) * size]
            if entry[:16] == bytes(16):
                continue
            start, end = struct.unpack_from("<QQ", entry, 32)
            if start < 34 or end < start or (end + 1) * 512 > image_size:
                fail("GPT partition outside image")
            if any(start <= other_end and end >= other_start
                   for other_start, other_end in extents):
                fail("overlapping GPT partitions")
            extents.append((start, end))
            label = entry[56:128].decode("utf-16-le").rstrip("\0")
            if label in partitions:
                fail("duplicate GPT partition label")
            partitions[label] = {
                "offset": start * 512, "size": (end - start + 1) * 512,
                "uuid": uuid.UUID(bytes_le=entry[16:32]).hex,
            }
        return partitions


def copy_partition(image, partition, output):
    with Path(image).open("rb") as source, Path(output).open("wb") as target:
        source.seek(partition["offset"])
        remaining = partition["size"]
        while remaining:
            chunk = source.read(min(remaining, 1024 * 1024))
            if not chunk:
                fail("truncated partition")
            target.write(chunk)
            remaining -= len(chunk)


def ddi_request(image, request, name, version, kind):
    """Request a signature over the pre-built DDI filesystem and hash."""
    partitions = gpt_partitions(image)
    if partitions is None or not all(label in partitions for label in
                                     ("extkit-root", "extkit-verity", "extkit-signature")):
        fail("expected an ExtKit GPT image with filesystem, verity and signature partitions")
    with Path(image).open("rb") as source:
        source.seek(partitions["extkit-verity"]["offset"])
        header = source.read(512)
    fields = struct.unpack_from("<8sII16s32sIIQH6x256s", header)
    magic, version_format, hash_type, _, algorithm, data_size, hash_size, blocks, salt_size, salt = fields
    if (magic != b"verity\0\0" or version_format != 1 or hash_type != 1 or
            algorithm.rstrip(b"\0") != b"sha256" or data_size != 4096 or
            hash_size != 4096 or not 1 <= salt_size <= 256):
        fail("unsupported verity superblock")
    if blocks * 4096 != partitions["extkit-root"]["size"]:
        fail("verity data size differs from filesystem partition size")
    with tempfile.TemporaryDirectory(prefix="extkit-request-") as work:
        filesystem = Path(work) / "extension.erofs"
        copy_partition(image, partitions["extkit-root"], filesystem)
        root_hash = verity_root_hash(filesystem, blocks, salt[:salt_size], work)
    expected = partitions["extkit-root"]["uuid"] + partitions["extkit-verity"]["uuid"]
    if root_hash != expected:
        fail("pre-built DDI root hash differs from signing request")
    metadata = json_bytes({
        "format": "org.extkit.signing-request.v3", "name": name,
        "version": str(version), "kind": kind, "imageEntry": "extension.raw",
        "imageSha256": file_sha256(image), "rootHash": root_hash,
    })
    request = Path(request)
    request.parent.mkdir(parents=True, exist_ok=True)
    temporary_request = request.with_suffix(request.suffix + ".tmp")
    try:
        with zipfile.ZipFile(temporary_request, "w", allowZip64=True) as archive:
            archive.writestr("request.json", metadata, compress_type=zipfile.ZIP_DEFLATED)
            archive.write(image, "extension.raw", compress_type=zipfile.ZIP_STORED)
        temporary_request.replace(request)
    finally:
        temporary_request.unlink(missing_ok=True)
    return root_hash


def prepare_ddi(filesystem, output, request, name, version, kind):
    """Let systemd-repart build GPT and verity; reserve space for offline signing."""
    filesystem = Path(filesystem).resolve()
    data_size = filesystem.stat().st_size
    if not data_size or data_size % 4096:
        fail("EROFS size must be a non-zero multiple of 4096")
    with tempfile.TemporaryDirectory(prefix="extkit-repart-") as work:
        definitions = Path(work)
        # CopyBlocks takes a literal absolute path; reject config metacharacters.
        if any(character in str(filesystem) for character in ('%', '\\', '\n', '\r')):
            fail("unsupported characters in filesystem image path")
        (definitions / "10-root.conf").write_text(
            '[Partition]\nType=root\nLabel=extkit-root\n'
            f'CopyBlocks={filesystem}\nSizeMinBytes={data_size}\nSizeMaxBytes={data_size}\n'
            'ReadOnly=yes\nVerity=data\nVerityMatchKey=root\n'
        )
        (definitions / "20-verity.conf").write_text(
            '[Partition]\nType=root-verity\nLabel=extkit-verity\n'
            'ReadOnly=yes\nVerity=hash\nVerityMatchKey=root\n'
            'VerityDataBlockSizeBytes=4096\nVerityHashBlockSizeBytes=4096\n'
        )
        (definitions / "30-signature.conf").write_text(
            '[Partition]\nType=root-verity-sig\nLabel=extkit-signature\n'
            f'SizeMinBytes={SIGNATURE_BYTES}\nSizeMaxBytes={SIGNATURE_BYTES}\nReadOnly=yes\n'
        )
        subprocess.run([
            REPART_TOOL, "--empty=create", "--size=auto", "--offline=yes",
            "--dry-run=no", "--sector-size=512", "--definitions", str(definitions),
            str(output),
        ], check=True)
    return ddi_request(output, request, name, version, kind)


def install_returned_extension(image, request, returned):
    """Install the phone's finished bytes; permit changes only in its signature slot."""
    image, returned = Path(image), Path(returned)
    with zipfile.ZipFile(request) as archive:
        metadata = json.loads(archive.read("request.json"))
    if metadata["format"] != "org.extkit.signing-request.v3":
        fail("expected a GPT signing request")
    if file_sha256(image) != metadata["imageSha256"]:
        fail("original image changed after preparing the request")
    partitions = gpt_partitions(image)
    if partitions is None or "extkit-signature" not in partitions:
        fail("no reserved signature partition")
    if returned.stat().st_size != image.stat().st_size or gpt_partitions(returned) != partitions:
        fail("phone changed the image size or GPT layout")
    partition = partitions["extkit-signature"]
    if partition["size"] != SIGNATURE_BYTES:
        fail("unexpected signature partition size")
    with returned.open("rb") as source:
        source.seek(partition["offset"])
        response = json.loads(source.read(partition["size"]).rstrip(b"\0"))
    if response.get("rootHash") != metadata["rootHash"]:
        fail("returned signature does not match the requested root hash")
    cms = base64.b64decode(response["signature"], validate=True)
    if not cms or len(cms) > SIGNATURE_BYTES:
        fail("invalid signature size")
    # The kernel establishes CMS trust at activation. The authenticated transfer
    # identifies the phone
    with image.open("rb") as original, returned.open("rb") as result:
        for start, length in ((0, partition["offset"]),
                              (partition["offset"] + partition["size"],
                               image.stat().st_size - partition["offset"] - partition["size"])):
            original.seek(start)
            result.seek(start)
            while length:
                amount = min(length, 1024 * 1024)
                if original.read(amount) != result.read(amount):
                    fail("phone changed bytes outside the signature partition")
                length -= amount
    with returned.open("rb") as source:
        os.fsync(source.fileno())
    returned.replace(image)
    descriptor = os.open(image.parent, os.O_DIRECTORY | os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def phone_sign_images(outputs, enabled):
    sign_image_batch([(kind, output, enabled[kind]) for kind, output in outputs.items()])


def sign_image_batch(targets):
    failures = []
    for _, output, _ in targets:
        output.with_suffix(".signed.raw").unlink(missing_ok=True)
    requests = [str(output.with_suffix(".extsign")) for _, output, _ in targets]
    try:
        subprocess.run([PHONE_TOOL, "send", *requests, "--kind", "extension"], check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"Warning: batch signing did not fully complete: {error}. Checking returned images.", file=sys.stderr, color="yellow")
    for kind, output, was_enabled in targets:
        name, _ = split_image_name(output)
        signing_request = output.with_suffix(".extsign")
        try:
            install_returned_extension(output, signing_request,
                                       output.with_suffix(".signed.raw"))
            if was_enabled:
                enable_image(kind, name, output)
            print(f"Stored signed {kind} image: {output}", color="green")
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
            _, image_version = split_image_name(output)
            print(f"Signing failed: {error}. Image and request retained. "
                  f"Retry: extkit sign {name} {image_version} --type {kind}",
                  file=sys.stderr, color="red")
            failures.append(output)
    if failures:
        fail("phone signing did not complete for all built images")


@state_transaction
def command_sign(args):
    if getattr(args, "untrusted", False) and os.geteuid() != 0:
        fail("sign --untrusted requires root to test kernel trust")
    if args.name is None:
        targets = [(kind, image) for kind in KINDS if args.kind is None or kind == args.kind
                   for image, _, _ in stored_extension_states(kind)
                   if (signature_status(image)[1] != "trusted" if args.untrusted else
                       signature_status(image, verify=False)[0] != "signed")]
    else:
        targets = list(requested_images(args.name, args.version, args.kind))
    if not targets:
        print("No extensions need signing.")
        return
    enabled = []
    for kind, image in targets:
        name, version = split_image_name(image)
        request = image.with_suffix(".extsign")
        ddi_request(image, request, name, version, kind)
        link = enabled_dir(kind) / f"{name}.raw"
        enabled.append((kind, image, link.is_symlink() and link.resolve() == image.resolve()))
    sign_image_batch(enabled)


def extension_search_directories():
    paths = {
        "sysext": ("etc/extensions", "run/extensions", "var/lib/extensions"),
        "confext": ("run/confexts", "var/lib/confexts", "usr/local/lib/confexts", "usr/lib/confexts"),
    }
    return {kind: {ROOT / relative for relative in paths[kind]} |
            {enabled_dir(kind), runtime_dir(kind)} for kind in KINDS}


def quarantine_extension(path, kind, reason):
    """Move discovery entries out of service search paths, preserving stored images."""
    path = Path(path)
    target = path.resolve()
    candidates = {path: kind}
    # Disable all aliases of this image, not just the name returned by discovery.
    for other_kind, directories in extension_search_directories().items():
        for directory in directories:
            if directory.is_dir():
                for entry in directory.iterdir():
                    if entry.is_symlink() and entry.resolve() == target:
                        candidates[entry] = other_kind
    root = STATE / "quarantine"
    root.mkdir(parents=True, exist_ok=True)
    if root.is_symlink() or not root.resolve().is_relative_to(STATE.resolve()):
        fail("quarantine must be inside StateDirectory, not a symlink")
    for entry, entry_kind in sorted(candidates.items()):
        if not entry.exists() and not entry.is_symlink():
            continue
        slot = root / uuid.uuid4().hex
        slot.mkdir(mode=0o700)
        record = {"kind": entry_kind, "name": entry.name, "original": str(entry),
                  "target": str(target), "reason": str(reason)[:4096],
                  "time": datetime.now(timezone.utc).isoformat(timespec="seconds")}
        (slot / "record.json").write_bytes(json_bytes(record))
        try:
            # shutil.move preserves symlinks instead of following them. Managed
            shutil.move(str(entry), str(slot / "entry"))
        except OSError as error:
            fail(f"cannot quarantine {entry}; refusing extension merge: {error}")
        print(f"WARNING: Quarantined {entry}: {reason}", file=sys.stderr, color="yellow")


def print_quarantine(kind=None):
    root = STATE / "quarantine"
    records = []
    for slot in sorted(root.iterdir()) if root.is_dir() and not root.is_symlink() else []:
        if not slot.is_dir() or slot.is_symlink():
            continue
        try:
            record = json.loads((slot / "record.json").read_text())
            if kind is None or record.get("kind") == kind:
                records.append((slot, record))
        except (OSError, ValueError):
            print(f"  quarantine: unreadable record at {slot}", color="yellow")
    print("  quarantine:" if records else "  quarantine: none")
    for slot, record in records:
        print(f"    {record['kind']}/{record['name']}: {record['reason']}\n"
              f"      since {record['time']}; original: {record['original']}; saved: {slot / 'entry'}")


def authenticate_extension_or_quarantine(path, kind, environment):
    try:
        if not path.is_file() or gpt_partitions(path) is None:
            raise ValueError("boot requires a regular GPT extension image")
    except (ValueError, OSError) as error:
        quarantine_extension(path, kind, error)
        return False
    try:
        subprocess.run([
            "systemd-dissect", "--read-only", f"--image-policy={SIGNED_POLICY}",
            "--with", str(path), "/usr/bin/true",
        ], check=True, env=environment, capture_output=True, text=True, timeout=60)
    except (ValueError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
        quarantine_extension(path, kind, getattr(error, "stderr", None) or str(error))
        return False
    return True


@state_transaction
def command_boot_check(args):
    # Both services scan shared discovery paths; serialize quarantine and sync
    # so they cannot race while moving the same malicious entry.
    RUNTIME_DIRECTORY.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(RUNTIME_DIRECTORY / "extkit-boot-check.lock",
                         os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        boot_check_locked(args)


def boot_check_locked(args):
    """Boot prerequisite: no directory images, kernel-authenticated DDIs."""
    loader = "systemd-sysext" if args.kind == "sysext" else "systemd-confext"
    environment = verification_environment()
    if args.kind == "sysext":
        environment["SYSTEMD_SYSEXT_HIERARCHIES"] = ":".join(
            "/" + hierarchy for hierarchy in KINDS["sysext"])
    # Discovery collapses duplicate names. Inspect every search directory as
    # well, so a shadowed directory cannot escape the boot prerequisite.
    # Remove directory attacks even if shadowed by another discovery entry.
    for kind, directories in extension_search_directories().items():
        for directory in sorted(directories):
            if directory.is_dir():
                for entry in list(directory.iterdir()):
                    if entry.is_dir():
                        quarantine_extension(entry, kind, "directory/subvolume extensions are not authenticated images")
    command_sync(SimpleNamespace(kind=args.kind, boot=True))
    # Verify individual candidates before asking systemd to read release metadata:
    authenticated = set()
    for directory in sorted(extension_search_directories()[args.kind]):
        for path in sorted(directory.glob("*.raw")) if directory.is_dir() else []:
            if not path.exists() and not path.is_symlink():
                continue
            resolved = path.resolve()
            if resolved not in authenticated and authenticate_extension_or_quarantine(path, args.kind, environment):
                authenticated.add(resolved)
    # image policy is not consulted for directory images.
    # Examine ALL of systemd's discovery locations
    discovered = subprocess.run(
        [loader, *([f"--root={ROOT}"] if ROOT != Path("/") else []), "--json=short", "list"], check=True, capture_output=True,
        text=True, env=environment,
    )
    images = json.loads(discovered.stdout or "[]")
    if not isinstance(images, list):
        fail("unexpected extension discovery response")
    for image in images:
        if image.get("type") != "raw":
            quarantine_extension(Path(image["path"]), args.kind, "non-image extension")
            continue
        path = Path(image["path"])
        # sysext reads release metadata using its default policy before applying
        # the merge policy. Authenticate first, before that filesystem access.
        if path.resolve() not in authenticated:
            authenticate_extension_or_quarantine(path, args.kind, environment)
    mutable = ROOT / "var/lib/extensions.mutable"
    if (mutable.resolve() != (RUNTIME_DIRECTORY / "extensions.mutable").resolve()
            or not mutable.resolve().is_relative_to(RUNTIME_DIRECTORY.resolve())):
        fail("mutable extension data must be backed by /run, not persistent storage")


def warn_if_signing_key_unenrolled():
    try:
        subprocess.run([PHONE_TOOL, "check-enrollment"], check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        print("WARNING: User signing key enrollment could not be confirmed. "
             "Continuing extension creation, but boot-time verification will reject "
             "images signed by an untrusted key. Run 'extkit-phone setup' and reboot. "
             "If boot.img is already personalized, reboot to load its key. "
             f"({error})", file=sys.stderr, color="yellow")


def offer_build_signing(outputs, name, version, enabled, no_sign=False):
    print("WARNING: These images cannot be loaded under the signed-image policy until "
          "they are signed by a trusted key. Their contents take effect only after "
          "the extensions are enabled and merged (mounted).", file=sys.stderr, color="yellow")
    sign_now = False
    if not no_sign:
        while True:
            try:
                answer = input("Sign the built extension image(s) now? [y/N] ").strip().lower()
            except (EOFError, OSError):
                # No interactive input: keep the prepared images for later signing.
                break
            if answer in ("", "n", "no", "later"):
                break
            if answer in ("y", "yes", "now"):
                sign_now = True
                break
            print("Enter y to sign now, or n to sign later.", color="yellow")
    if sign_now:
        phone_sign_images(outputs, enabled)
    else:
        print("Signing deferred. Images and signing requests have been retained.")
        for kind in outputs:
            print(f"Sign later: extkit sign {name} {version} --type {kind}")


@state_transaction
def command_build(args):
    checked_name(args.name)
    warn_if_signing_key_unenrolled()
    selection = load_selection()
    deletions = load_deletions()
    if not selection and not deletions:
        fail("selection is empty")
    grouped = {kind: [] for kind in KINDS}
    grouped_deletions = {kind: [] for kind in KINDS}
    for value in selection:
        relative = relative_path(value)
        kind = kind_for(relative)
        if args.kind is None or args.kind == kind:
            grouped[kind].append(relative)
    for value in deletions:
        relative = relative_path(value)
        kind = kind_for(relative)
        if args.kind is None or args.kind == kind:
            grouped_deletions[kind].append(relative)
    existing = {
        kind: image_versions(kind, args.name)
        for kind in KINDS
    }
    version = 1 + max(
        (number for versions in existing.values() for number in versions),
        default=0,
    )
    outputs = {kind: store_dir(kind) / f"{args.name}_{version}.raw"
               for kind in KINDS if grouped[kind] or grouped_deletions[kind]}
    if not outputs:
        fail(f"selection has no {args.kind} paths")
    previously_enabled = {}
    update_policies = {}
    for kind in outputs:
        link = enabled_dir(kind) / f"{args.name}.raw"
        previously_enabled[kind] = (
            link.is_symlink() and link.resolve().is_relative_to(store_dir(kind))
        )
        previous = existing[kind].get(max(existing[kind])) if existing[kind] else None
        inherited = embedded_update_policy(kind, previous)[0] if previous else "persistent"
        update_policies[kind] = getattr(args, "updates", None) or inherited
    workdir = STATE / "work"
    workdir.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="extkit-", dir=workdir) as work:
        drafts = {}
        for kind, output in outputs.items():
            tree = Path(work) / kind / "tree"
            tree.mkdir(parents=True)
            if existing[kind]:
                copy_image_tree(existing[kind][max(existing[kind])], tree)
            for relative in grouped[kind]:
                copy_selected(live_file(relative), tree / relative)
            for relative in grouped_deletions[kind]:
                whiteout = tree / relative
                remove_path(whiteout)
                whiteout.parent.mkdir(parents=True, exist_ok=True)
                os.mknod(whiteout, stat.S_IFCHR, os.makedev(0, 0))
            release_metadata(tree, args.name, kind, str(version), update_policies[kind])
            draft = Path(work) / f"{kind}.raw"
            subprocess.run([EROFS_TOOL, str(draft), str(tree)], check=True)
            drafts[kind] = draft
        for kind, output in outputs.items():
            output.parent.mkdir(parents=True, exist_ok=True)
            ddi = Path(work) / f"{kind}-ddi.raw"
            prepare_ddi(drafts[kind], ddi, output.with_suffix(".extsign"),
                        args.name, str(version), kind)
            drafts[kind] = ddi
            drafts[kind].replace(output)
        for kind, output in outputs.items():
            print(f"Built unsigned disabled {kind} image: {output}", color="green")
    built = {"/" + str(path) for paths in grouped.values() for path in paths}
    built_deletions = {"/" + str(path) for paths in grouped_deletions.values() for path in paths}
    save_selection(set(selection) - built)
    save_deletions(set(deletions) - built_deletions)
    offer_build_signing(outputs, args.name, str(version), previously_enabled,
                        no_sign=getattr(args, "no_sign", False))


def command_list(args):
    for kind in KINDS:
        if args.kind is not None and kind != args.kind:
            continue
        directory = store_dir(kind)
        for image in sorted(directory.glob("*.raw")) if directory.exists() else []:
            parsed = split_image_name(image)
            if parsed is None:
                continue
            name, _ = parsed
            link = enabled_dir(kind) / f"{name}.raw"
            status = "enabled" if link.is_symlink() and link.resolve() == image.resolve() else "disabled"
            signature, trust, _ = signature_status(image)
            print(f"{kind}\t{name}\t{image.name}\t{status}\tsignature: {signature}\ttrust: {trust}")


def version_key(value):
    return tuple((0, int(part)) if part.isdigit() else (1, part.casefold())
                 for part in re.split(r"([0-9]+)", value))


def split_image_name(image):
    stem = image.name.removesuffix(".raw")
    if "_" not in stem:
        return None
    return stem.split("_", 1)


def enable_image(kind, name, image):
    link = enabled_dir(kind) / f"{name}.raw"
    link.parent.mkdir(parents=True, exist_ok=True)
    temporary = link.with_name(f".{link.name}.{os.getpid()}.tmp")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(image)
    temporary.replace(link)
    return link


@state_transaction
def command_enable(args):
    if args.name == "*":
        if args.version is not None:
            fail("a version cannot be specified when enabling '*'")
        candidates = []
        for kind in (args.kind,) if args.kind else KINDS:
            newest = {}
            directory = store_dir(kind)
            for image in directory.glob("*.raw") if directory.exists() else []:
                parsed = split_image_name(image)
                if parsed is None:
                    continue
                name, version = parsed
                current = newest.get(name)
                if current is None or version_key(version) > version_key(current[0]):
                    newest[name] = (version, image)
            for name, (_, image) in sorted(newest.items()):
                link = enabled_dir(kind) / f"{name}.raw"
                if not link.exists() and not link.is_symlink():
                    candidates.append((kind, name, image))
        if not candidates:
            fail("no disabled extensions found")
        for kind, name, image in candidates:
            link = enable_image(kind, name, image)
            print(f"Enabled on next boot: {link} -> {image}", color="green")
        return
    checked_name(args.name)
    candidates = requested_images(args.name, args.version, args.kind)
    for kind, image in candidates:
        link = enable_image(kind, args.name, image)
        print(f"Enabled on next boot: {link} -> {image}", color="green")


@state_transaction
def command_disable(args):
    if args.name == "*":
        candidates = []
        for kind in (args.kind,) if args.kind else KINDS:
            directory = enabled_dir(kind)
            for link in sorted(directory.glob("*.raw")) if directory.exists() else []:
                if link.is_symlink() and link.resolve().is_relative_to(store_dir(kind)):
                    candidates.append((kind, link))
        if not candidates:
            fail("no managed enabled extensions found")
        for kind, link in candidates:
            link.unlink()
            print(f"Disabled on next boot: {kind}/{link.stem}", color="green")
        return
    checked_name(args.name)
    candidates = []
    for kind in (args.kind,) if args.kind else KINDS:
        link = enabled_dir(kind) / f"{args.name}.raw"
        if link.is_symlink() and link.resolve().is_relative_to(store_dir(kind)):
            candidates.append((kind, link))
    if not candidates:
        fail(f"no managed enabled images for {args.name}")
    for kind, link in candidates:
        link.unlink()
        print(f"Disabled on next boot: {kind}/{args.name}", color="green")


@state_transaction
def command_policy(args):
    checked_name(args.name)
    warn_if_signing_key_unenrolled()
    all_existing = {
        kind: image_versions(kind, args.name)
        for kind in KINDS
    }
    existing = {
        kind: image_versions(kind, args.name)
        for kind in ((args.kind,) if args.kind else KINDS)
    }
    existing = {kind: versions for kind, versions in existing.items() if versions}
    if not existing:
        fail(f"no built images found for {args.name}")
    version = 1 + max(number for versions in all_existing.values() for number in versions)
    workdir = STATE / "work"
    workdir.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="extkit-policy-", dir=workdir) as work:
        drafts = {}
        enabled = {}
        for kind, versions in existing.items():
            previous = versions[max(versions)]
            tree = Path(work) / kind / "tree"
            tree.mkdir(parents=True)
            copy_image_tree(previous, tree)
            release_metadata(tree, args.name, kind, str(version), args.updates)
            draft = Path(work) / f"{kind}.raw"
            subprocess.run([EROFS_TOOL, str(draft), str(tree)], check=True)
            drafts[kind] = draft
            link = enabled_dir(kind) / f"{args.name}.raw"
            enabled[kind] = (
                link.is_symlink() and link.resolve().is_relative_to(store_dir(kind))
            )
        for kind, draft in drafts.items():
            output = store_dir(kind) / f"{args.name}_{version}.raw"
            output.parent.mkdir(parents=True, exist_ok=True)
            ddi = Path(work) / f"{kind}-ddi.raw"
            prepare_ddi(draft, ddi, output.with_suffix(".extsign"),
                        args.name, str(version), kind)
            draft = ddi
            draft.replace(output)
            print(f"Rebuilt {kind} policy as {args.updates}: {output}", color="green")
        offer_build_signing(
            {kind: store_dir(kind) / f"{args.name}_{version}.raw" for kind in drafts},
            args.name, str(version), enabled,
        )


@state_transaction
def command_sync(args):
    """Synchronize enabled images into systemd's runtime discovery directory."""
    kind = args.kind
    destination = runtime_dir(kind)
    if destination.is_symlink():
        destination.unlink()
    destination.mkdir(parents=True, exist_ok=True)
    for entry in destination.iterdir():
        if getattr(args, "boot", False) and entry.is_dir():
            quarantine_extension(entry, kind, "unmanaged directory extension")
            continue
        if getattr(args, "boot", False) and entry.is_file() and not entry.is_symlink():
            # Leave raw runtime images available for the boot checker
            continue
        if entry.is_symlink() or entry.is_file():
            entry.unlink()
        elif entry.is_dir():
            fail(f"runtime extension directory contains unmanaged directory: {entry}")
    source = enabled_dir(kind)
    if getattr(args, "boot", False) and source.is_dir():
        for entry in source.iterdir():
            if entry.is_dir():
                quarantine_extension(entry, kind, "directory/subvolume extension")
    for link in sorted(source.glob("*.raw")) if source.exists() else []:
        if not link.is_symlink() or not link.resolve().is_relative_to(store_dir(kind)):
            continue
        image = link.resolve()
        if not image.is_file():
            if getattr(args, "boot", False):
                quarantine_extension(link, kind, "missing or non-regular image target")
            continue
        runtime = destination / link.name
        if not runtime.exists() and not runtime.is_symlink():
            runtime.symlink_to(link)


def describe_entry(path, relative):
    info = path.lstat()
    mode = stat.filemode(info.st_mode)
    if path.is_symlink():
        return f"l {mode} /{relative} -> {os.readlink(path)}"
    if stat.S_ISCHR(info.st_mode) and info.st_rdev == os.makedev(0, 0):
        return f"w {mode} /{relative} (deletion whiteout)"
    if path.is_file():
        return f"f {mode} {info.st_size:>9} /{relative}"
    return f"? {mode} /{relative}"


def image_entries(tree):
    entries = {}
    for directory, names, files in os.walk(tree, followlinks=False):
        directory = Path(directory)
        for name in names + files:
            path = directory / name
            if path.is_dir() and not path.is_symlink():
                continue
            relative = path.relative_to(tree)
            entries[str(relative)] = path
    return entries


def command_inspect(args):
    for kind, image in requested_images(args.name, args.version, args.kind):
        print(f"{kind} {image.name}:")
        with image_tree(image) as tree:
            for relative, path in sorted(image_entries(tree).items()):
                print(f"  {describe_entry(path, relative)}")


def show_image_difference(old_tree, new_tree, old_label, new_label):
    old_entries = image_entries(old_tree)
    new_entries = image_entries(new_tree)
    for relative in sorted(set(old_entries) | set(new_entries)):
        old = old_entries.get(relative)
        new = new_entries.get(relative)
        if old is None:
            print(f"ADDED /{relative}")
            continue
        if new is None:
            print(f"REMOVED /{relative}")
            continue
        old_info, new_info = old.lstat(), new.lstat()
        if old.is_symlink() or new.is_symlink():
            old_value = os.readlink(old) if old.is_symlink() else "<not a symlink>"
            new_value = os.readlink(new) if new.is_symlink() else "<not a symlink>"
            if old_value != new_value:
                print(f"CHANGED /{relative}: {old_value!r} -> {new_value!r}")
            continue
        old_whiteout = stat.S_ISCHR(old_info.st_mode) and old_info.st_rdev == os.makedev(0, 0)
        new_whiteout = stat.S_ISCHR(new_info.st_mode) and new_info.st_rdev == os.makedev(0, 0)
        if old_whiteout or new_whiteout:
            if old_whiteout != new_whiteout:
                print(f"CHANGED /{relative}: {'deleted' if old_whiteout else 'present'} -> "
                      f"{'deleted' if new_whiteout else 'present'}")
            continue
        if not old.is_file() or not new.is_file():
            if stat.S_IFMT(old_info.st_mode) != stat.S_IFMT(new_info.st_mode):
                print(f"TYPE CHANGED /{relative}")
            continue
        old_bytes, new_bytes = old.read_bytes(), new.read_bytes()
        if old_bytes == new_bytes and stat.S_IMODE(old_info.st_mode) == stat.S_IMODE(new_info.st_mode):
            continue
        if b"\0" in old_bytes or b"\0" in new_bytes:
            print(f"BINARY CHANGED /{relative}: {len(old_bytes)} -> {len(new_bytes)} bytes")
        else:
            before = old_bytes.decode("utf-8", "replace").splitlines(keepends=True)
            after = new_bytes.decode("utf-8", "replace").splitlines(keepends=True)
            sys.stdout.writelines(difflib.unified_diff(
                before, after,
                fromfile=f"{old_label}/{relative}", tofile=f"{new_label}/{relative}",
            ))
        if stat.S_IMODE(old_info.st_mode) != stat.S_IMODE(new_info.st_mode):
            print(f"MODE /{relative}: {stat.filemode(old_info.st_mode)} -> {stat.filemode(new_info.st_mode)}")


def command_compare(args):
    checked_name(args.name)
    pairs = []
    for kind in (args.kind,) if args.kind else KINDS:
        versions = image_versions(kind, args.name)
        if args.versions:
            requested = [int(value) for value in args.versions]
            if all(version in versions for version in requested):
                pairs.extend(
                    (kind, versions[old_version], versions[new_version])
                    for old_version, new_version in zip(requested, requested[1:])
                )
        elif len(args.versions) == 0 and len(versions) >= 2:
            newest = sorted(versions)[-2:]
            pairs.append((kind, versions[newest[0]], versions[newest[1]]))
    if not pairs:
        fail("compare needs at least two existing versions")
    for kind, old, new in pairs:
        print(f"{kind}: {old.name} -> {new.name}")
        with image_tree(old) as old_tree, image_tree(new) as new_tree:
            show_image_difference(old_tree, new_tree, old.name, new.name)


def addon_versions(name):
    checked_name(name)
    directory = STATE / "store/addon"
    pattern = re.compile(re.escape(name) + r"_([1-9][0-9]*)\.addon\.efi\Z")
    return {int(match[1]): path for path in directory.glob(f"{name}_*.addon.efi")
            if (match := pattern.fullmatch(path.name))}


def selected_addon(args):
    versions = addon_versions(args.name)
    version = int(args.version) if getattr(args, "version", None) else max(versions, default=0)
    if version not in versions:
        fail("addon version not found")
    return versions[version]


def addon_boot_directory():
    directory = Path(ADDON_SETTINGS.get("bootdirectory", "/boot"))
    if not directory.is_absolute():
        fail("addon BootDirectory must be absolute")
    directory.stat()  # Trigger the ESP automount.
    if not os.path.ismount(directory):
        fail(f"ESP is not mounted at {directory}")
    return directory / "loader/addons"


def addon_certificates():
    return enrolled_certificates(ADDON_SETTINGS.get("uefidbglob", "/sys/firmware/efi/efivars/db-*"))


def sign_addon(image, enable=True):
    name, version = image.name.removesuffix(".addon.efi").rsplit("_", 1)
    payload = image.with_name(image.name.removesuffix(".addon.efi") + ".addonsign")
    if not addons.inspect(image.read_bytes())[2]:
        addons.request(image, payload, name, version)
        subprocess.run([PHONE_TOOL, "send", str(payload), "--kind", "addon", "--output", str(image)], check=True)
    if not addons.verify(image, addon_certificates()):
        print("WARNING: Signed addon retained, but its key is not trusted by the live Secure Boot db. "
              "Enroll the phone key and reboot, then run extkit addon enable " + name, color="yellow")
        return
    if enable:
        installed = addons.install(image, addon_boot_directory(), name, addon_certificates())
        print(f"Enabled addon for next boot: {installed}", color="green")


@state_transaction
def command_addon(args):
    action = args.action
    if action == "build":
        checked_name(args.name)
        if len(args.name) > 128:
            fail("addon name must not exceed 128 characters")
        command_line = args.cmdline
        if args.machine_id is not None:
            identity = (ROOT / "etc/machine-id").read_text().strip() if args.machine_id == "current" else args.machine_id
            if not re.fullmatch(r"[0-9a-f]{32}", identity) or identity == "0" * 32:
                fail("machine ID must be 32 lowercase hexadecimal digits and nonzero")
            command_line = "systemd.machine_id=" + identity
        architecture = args.architecture or ADDON_SETTINGS.get("architecture")
        if architecture is None:
            architecture = {"aarch64": "arm64", "x86_64": "x86-64"}.get(os.uname().machine)
        data = addons.build(command_line, architecture)
        version = max(addon_versions(args.name), default=0) + 1
        directory = STATE / "store/addon"
        directory.mkdir(parents=True, exist_ok=True)
        image = directory / f"{args.name}_{version}.addon.efi"
        with image.open("xb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        addons.request(image, image.with_name(f"{args.name}_{version}.addonsign"), args.name, version)
        print(f"Built unsigned addon: {image}\nCommand line: {command_line}", color="green")
        if args.no_sign:
            print(f"WARNING: Not usable until signed. Run extkit addon sign {args.name} {version}.", color="yellow")
        elif input("Sign on the phone and install for next boot now? [Y/n] ").strip().lower() in ("", "y", "yes"):
            warn_if_signing_key_unenrolled()
            sign_addon(image)
    elif action == "sign":
        warn_if_signing_key_unenrolled()
        sign_addon(selected_addon(args), enable=not args.no_enable)
    elif action == "enable":
        image = selected_addon(args)
        installed = addons.install(image, addon_boot_directory(), args.name, addon_certificates())
        print(f"Enabled addon for next boot: {installed}", color="green")
    elif action == "disable":
        checked_name(args.name)
        path = addon_boot_directory() / f"{args.name}.addon.efi"
        path.unlink(missing_ok=True)
        os.sync()
        print(f"Disabled addon for next boot: {args.name}", color="green")
    elif action == "inspect":
        image = selected_addon(args)
        command_line, architecture, signed = addons.inspect(image.read_bytes())
        print(f"{image.name}: {architecture}; signature: {'signed' if signed else 'unsigned'}\n{command_line}")
    elif action == "list":
        print_addon_status()


def print_addon_status(indent=""):
    images = sorted((STATE / "store/addon").glob("*.addon.efi"))
    if not images:
        print(f"{indent}none")
        return
    certificates = addon_certificates()
    for image in images:
        try:
            command_line, architecture, signed = addons.inspect(image.read_bytes())
            trusted = addons.verify(image, certificates) if signed else False
            name = image.name.removesuffix(".addon.efi").rsplit("_", 1)[0]
            active = Path(ADDON_SETTINGS.get("bootdirectory", "/boot")) / "loader/addons" / f"{name}.addon.efi"
            enabled = active.is_file() and active.read_bytes() == image.read_bytes()
            print(f"{indent}{image.name}: {architecture}; signature: {'signed' if signed else 'unsigned'}; "
                  f"trust: {'trusted' if trusted else 'not trusted'}; "
                  f"{'enabled for boot' if enabled else 'disabled'}\n{indent}  {command_line}")
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            print(f"{indent}{image.name}: cannot inspect: {error}", color="yellow")


def main():
    pre_parser = argparse.ArgumentParser(add_help=False)
    pre_parser.add_argument("--config", type=Path, default=Path("/etc/extkit.conf"))
    preliminary, _ = pre_parser.parse_known_args()
    try:
        configure(preliminary.config)
    except (ValueError, OSError, KeyError, configparser.Error) as exc:
        pre_parser.error(str(exc))

    parser = argparse.ArgumentParser(description=__doc__, parents=[pre_parser])
    sub = parser.add_subparsers(dest="command")
    for command in ("status", "diff", "stage", "unstage", "build", "enable",
                    "disable", "inspect", "compare", "policy", "sync", "sign", "boot-check"):
        p = sub.add_parser(command)
        p.add_argument("--type", dest="kind", choices=KINDS)
        if command == "build":
            p.add_argument("name")
        elif command in ("enable", "disable"):
            p.add_argument("targets", nargs="+")
        elif command in ("inspect", "sign"):
            p.add_argument("name", **({"nargs": "?"} if command == "sign" else {}))
            p.add_argument("version", nargs="?")
            if command == "sign":
                p.add_argument("--untrusted", action="store_true", help="sign every image not accepted by the current kernel trust policy")
        elif command == "compare":
            p.add_argument("name")
            p.add_argument("versions", nargs="*")
        elif command == "policy":
            p.add_argument("name")
            p.add_argument("updates", choices=UPDATE_POLICIES)
        if command == "diff":
            p.add_argument("--staged", action="store_true")
        if command in ("diff", "stage", "unstage"):
            p.add_argument("paths", nargs="*")
        if command == "build":
            p.add_argument("--updates", choices=UPDATE_POLICIES)
            p.add_argument("--no-sign", action="store_true", help="prepare images now and sign them later with extkit sign")
    sub.add_parser("list").add_argument("--type", dest="kind", choices=KINDS)
    sub.add_parser("boot-update-check", help="show factory boot images staged by systemd-sysupdate")
    boot_update = sub.add_parser("boot-update", help="verify and send a staged factory boot image for phone signing")
    boot_update.add_argument("version", nargs="?", help="staged version; defaults to newest update")
    addon = sub.add_parser("addon", help="build, phone-sign and install command-line UKI addons")
    actions = addon.add_subparsers(dest="action", required=True)
    build = actions.add_parser("build")
    build.add_argument("name")
    content = build.add_mutually_exclusive_group(required=True)
    content.add_argument("--cmdline", help="exact additional kernel command-line parameters")
    content.add_argument("--machine-id", nargs="?", const="current", help="persist this ID; defaults to live /etc/machine-id")
    build.add_argument("--architecture", choices=addons.MACHINES)
    build.add_argument("--no-sign", action="store_true")
    for action in ("sign", "enable", "inspect"):
        item = actions.add_parser(action)
        item.add_argument("name")
        item.add_argument("version", nargs="?")
        if action == "sign":
            item.add_argument("--no-enable", action="store_true")
    actions.add_parser("disable").add_argument("name")
    actions.add_parser("list")
    args = parser.parse_args()
    show_help_after_status = args.command is None
    if show_help_after_status:
        args.command = "status"
        args.kind = None
    if args.command in ("enable", "disable"):
        targets = normalize_shell_glob(args.targets)
        if targets == ["*"]:
            args.name, args.version = "*", None
        elif args.command == "enable" and len(targets) in (1, 2):
            args.name, args.version = targets[0], targets[1] if len(targets) == 2 else None
        elif args.command == "disable" and len(targets) == 1:
            args.name, args.version = targets[0], None
        else:
            parser.error("enable expects NAME [VERSION] or '*'; disable expects NAME or '*'")
    if args.command == "compare" and len(args.versions) == 1:
        parser.error("compare expects NAME or NAME VERSION VERSION [VERSION ...]")
    if args.command in ("sync", "boot-check") and args.kind is None:
        parser.error(f"{args.command} requires --type")
    try:
        globals()[f"command_{args.command.replace('-', '_')}"](args)
        if show_help_after_status:
            print()
            parser.print_help()
    except (ValueError, OSError, subprocess.CalledProcessError, KeyError, configparser.Error) as exc:
        print(f"extkit: {exc}", file=sys.stderr, color="red")
        raise SystemExit(1)


if __name__ == "__main__":
    main()
