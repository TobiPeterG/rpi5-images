#!/usr/bin/python3
"""Discover and use an ExtKit phone signer"""

import argparse
import builtins
import base64
import fcntl
import configparser
import glob
import hashlib
import json
import os
import re
import secrets
import shutil
import socket
import ssl
import struct
import subprocess
import sys
import tempfile
import time
import uuid
from dataclasses import dataclass
from pathlib import Path

PROTOCOL = "org.extkit.signing-network.v1"
BINDING_DOMAIN = b"org.extkit.transport-binding.v1\n"
PAIRING_DOMAIN = b"org.extkit.pairing.v1\0"
EFI_CERT_X509_GUID = uuid.UUID("a5c059a1-94e4-4aa7-87b5-ab155c2bf072")
MAX_HEADER = 64 * 1024
PENDING_ENROLLMENT = Path("/run/extkit-phone/pending-enrollment")


def print(*values, **options):
    stream = options.get("file", sys.stdout)
    text = options.get("sep", " ").join(str(value) for value in values)
    lower = text.lstrip().lower()
    color = ("31" if lower.startswith(("✗", "extkit-phone:", "phone setup did not complete")) else
             "33" if lower.startswith(("warning:", "ignored:", "could not", "no extkit", "skipped")) else
             "32" if lower.startswith(("✓", "received ", "installed ", "saved ", "authenticated ", "request transfer finished", "signed boot files installed")) else None)
    if color and stream.isatty() and "NO_COLOR" not in os.environ and os.environ.get("TERM") != "dumb":
        options.pop("sep", None)
        builtins.print(f"\033[{color}m{text}\033[0m", **options)
    else:
        builtins.print(*values, **options)


class ExtKitPhoneError(RuntimeError):
    pass


class PhoneRequestDismissed(ExtKitPhoneError):
    pass


@dataclass(frozen=True)
class Service:
    name: str
    address: str
    port: int


@dataclass(frozen=True)
class Phone:
    service: Service
    info: dict
    transport_certificate: bytes
    extension_fingerprint: str
    enrolled: bool


def fail(message):
    raise ExtKitPhoneError(message)


def load_config(path):
    parser = configparser.ConfigParser()
    if not parser.read(path):
        fail(f"configuration not found: {path}")
    section = parser["Network"]
    return {
        "boot_directory": Path(section.get("BootDirectory", "/boot")),
        "service_type": section.get("ServiceType", "_extkit-sign._tcp"),
        "db_glob": section.get("UefiDbGlob", "/sys/firmware/efi/efivars/db-*"),
        "extension_owner": uuid.UUID(section.get("ExtensionOwnerGuid", "48bdddca-5476-4ef5-8171-ceb413e1a549")),
        "connect_timeout": section.getfloat("ConnectTimeoutSeconds", 10),
        "pairing_timeout": section.getfloat("PairingTimeoutSeconds", 120),
        "signing_timeout": section.getfloat("SigningTimeoutSeconds", 1800),
        "poll_interval": section.getfloat("PollIntervalSeconds", 2),
    }


def discover_services(service_type):
    command = ["avahi-browse", "--resolve", "--terminate", "--parsable", service_type]
    try:
        result = subprocess.run(command, check=False, text=True, capture_output=True, timeout=15)
    except FileNotFoundError:
        fail("avahi-browse is missing; install avahi-utils")
    except subprocess.TimeoutExpired:
        fail("local-network discovery timed out")
    if result.returncode != 0:
        fail((result.stderr or "avahi-browse failed").strip())
    found = {}
    for line in result.stdout.splitlines():
        fields = line.split(";")
        if len(fields) < 9 or fields[0] != "=":
            continue
        try:
            service = Service(unescape_avahi(fields[3]), unescape_avahi(fields[7]), int(fields[8]))
        except (ValueError, IndexError):
            continue
        found[(service.address, service.port)] = service
    return sorted(found.values(), key=lambda item: (item.name, item.address, item.port))


def unescape_avahi(value):
    output = bytearray()
    index = 0
    encoded = value.encode("utf-8")
    while index < len(encoded):
        if encoded[index:index + 1] == b"\\" and encoded[index + 1:index + 4].isdigit():
            output.append(int(encoded[index + 1:index + 4]))
            index += 4
        elif encoded[index:index + 2] == b"\\;":
            output.append(ord(";")); index += 2
        else:
            output.append(encoded[index]); index += 1
    return output.decode("utf-8", errors="replace")


def recv_exact(stream, length):
    chunks = []
    remaining = length
    while remaining:
        chunk = stream.recv(min(1024 * 1024, remaining))
        if not chunk:
            fail("phone closed the connection early")
        chunks.append(chunk); remaining -= len(chunk)
    return b"".join(chunks)


class TransferProgress:
    """Single-line progress on interactive terminals."""

    def __init__(self, label, total, stream=None):
        self.stream = sys.stderr if stream is None else stream
        self.label, self.total = label, total
        self.enabled = self.stream.isatty()
        self.last = 0.0
        self.update(0, force=True)

    def update(self, completed, force=False):
        now = time.monotonic()
        if not self.enabled or (not force and completed != self.total and now - self.last < 0.5):
            return
        self.last = now
        percent = min(100, completed * 100 // self.total) if self.total else 100
        filled = percent * 24 // 100
        self.stream.write(f"\r{self.label} [{'#' * filled}{'-' * (24 - filled)}] {percent:3d}% {completed}/{self.total} bytes")
        self.stream.flush()

    def finish(self):
        if self.enabled:
            self.stream.write("\n")
            self.stream.flush()


def exchange(service, request, payload=None, output=None, timeout=10, expected_peer=None, max_response=1024 * 1024):
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    with socket.create_connection((service.address, service.port), timeout=timeout) as raw:
        with context.wrap_socket(raw, server_hostname=None) as stream:
            peer = stream.getpeercert(binary_form=True)
            if expected_peer is not None and not secrets.compare_digest(peer, expected_peer):
                fail("phone TLS identity changed during the operation")
            header = json.dumps(request, separators=(",", ":")).encode()
            if len(header) > MAX_HEADER:
                fail("request header is too large")
            stream.sendall(struct.pack(">I", len(header)) + header)
            if payload:
                progress = TransferProgress("Sending", Path(payload).stat().st_size)
                completed = 0
                try:
                    with open(payload, "rb") as source:
                        while chunk := source.read(1024 * 1024):
                            stream.sendall(chunk)
                            completed += len(chunk)
                            progress.update(completed)
                finally:
                    progress.finish()
            size = struct.unpack(">I", recv_exact(stream, 4))[0]
            if not 2 <= size <= MAX_HEADER:
                fail("phone returned an invalid response header")
            response = json.loads(recv_exact(stream, size))
            if not response.get("ok"):
                fail(response.get("error", "phone rejected the request"))
            if response.get("protocol") != PROTOCOL:
                fail("phone uses an incompatible protocol")
            payload_length = int(response.get("payloadLength", 0))
            if not 0 <= payload_length <= max_response:
                fail("phone response exceeds the size limit")
            if output is None:
                body = recv_exact(stream, payload_length)
            else:
                remaining = payload_length
                progress = TransferProgress("Receiving", payload_length)
                try:
                    with open(output, "wb") as destination:
                        while remaining:
                            chunk = stream.recv(min(1024 * 1024, remaining))
                            if not chunk:
                                fail("phone closed the result transfer early")
                            destination.write(chunk); remaining -= len(chunk)
                            progress.update(payload_length - remaining)
                finally:
                    progress.finish()
                body = None
            return response, body, peer


def efi_x509_certificates(data, owner_guid=None):
    """Return DER certificates from an EFI signature-list payload."""
    certificates = []
    position = 0
    while position + 28 <= len(data):
        signature_type = uuid.UUID(bytes_le=data[position:position + 16])
        list_size, header_size, signature_size = struct.unpack_from("<III", data, position + 16)
        if list_size < 28 or position + list_size > len(data) or signature_size < 16:
            break
        entries = position + 28 + header_size
        end = position + list_size
        if entries > end or (end - entries) % signature_size:
            break
        if signature_type == EFI_CERT_X509_GUID:
            while entries + signature_size <= end:
                owner = uuid.UUID(bytes_le=data[entries:entries + 16])
                if owner_guid is None or owner == owner_guid:
                    certificates.append(data[entries + 16:entries + signature_size])
                entries += signature_size
        position = end
    return certificates


def enrolled_certificates(pattern, owner_guid=None):
    certificates = []
    for name in glob.glob(pattern):
        try:
            data = Path(name).read_bytes()
        except OSError:
            continue
        # efivarfs prefixes variable data with the four-byte EFI attributes.
        certificates.extend(efi_x509_certificates(data[4:], owner_guid))
    return certificates


def binding_payload(transport_fingerprint):
    return BINDING_DOMAIN + transport_fingerprint.lower().encode("ascii") + b"\n"


def verify_rsa_signature(certificate, signature, payload):
    if not shutil.which("openssl"):
        fail("openssl is required to verify the phone identity")
    with tempfile.TemporaryDirectory(prefix="extkit-phone-") as directory:
        certificate_file = Path(directory, "certificate.der")
        public_file = Path(directory, "public.pem")
        signature_file = Path(directory, "signature.bin")
        payload_file = Path(directory, "payload.bin")
        certificate_file.write_bytes(certificate)
        signature_file.write_bytes(signature)
        payload_file.write_bytes(payload)
        result = subprocess.run(
            ["openssl", "x509", "-inform", "DER", "-in", str(certificate_file), "-pubkey", "-noout", "-out", str(public_file)],
            capture_output=True,
        )
        if result.returncode:
            fail("phone returned an invalid extension certificate")
        result = subprocess.run(
            ["openssl", "dgst", "-sha256", "-verify", str(public_file), "-signature", str(signature_file), str(payload_file)],
            capture_output=True,
        )
        if result.returncode:
            fail("the extension key did not sign the phone transport key")


def inspect_phone(service, enrolled_fingerprints, timeout):
    response, _, peer = exchange(service, {"op": "info"}, timeout=timeout)
    info = response["info"]
    transport = base64.b64decode(info["transportCertificate"], validate=True)
    extension = base64.b64decode(info["extensionCertificate"], validate=True)
    signature = base64.b64decode(info["bindingSignature"], validate=True)
    if transport != peer:
        fail(f"{service.name}: TLS certificate differs from the advertised binding")
    transport_fingerprint = hashlib.sha256(transport).hexdigest()
    if transport_fingerprint != info["transportFingerprint"].lower():
        fail(f"{service.name}: transport certificate fingerprint mismatch")
    verify_rsa_signature(extension, signature, binding_payload(transport_fingerprint))
    extension_fingerprint = hashlib.sha256(extension).hexdigest()
    return Phone(service, info, transport, extension_fingerprint, extension_fingerprint in enrolled_fingerprints)


def find_phones(config):
    enrolled = {hashlib.sha256(item).hexdigest() for item in enrolled_certificates(config["db_glob"], config["extension_owner"])}
    phones = []
    errors = []
    for service in discover_services(config["service_type"]):
        try:
            phones.append(inspect_phone(service, enrolled, config["connect_timeout"]))
        except Exception as error:
            errors.append(f"{service.name}: {error}")
    return phones, errors


def choose_phone(phones, heading, always_list=False):
    if not phones:
        fail("no compatible ExtKit signer is visible on the local network")
    if len(phones) == 1 and not always_list:
        return phones[0]
    print(heading)
    for index, phone in enumerate(phones, 1):
        print(f"  {index}. {phone.service.name} ({phone.service.address}) {phone.extension_fingerprint[:16]}…")
    while True:
        try:
            selected = int(input(f"Enter the phone number (1–{len(phones)}): "))
            if not 1 <= selected <= len(phones):
                raise ValueError
            return phones[selected - 1]
        except (ValueError, IndexError):
            print("Enter one of the listed numbers.", file=sys.stderr)


def pairing_code(nonce, certificate):
    value = int.from_bytes(hashlib.sha256(PAIRING_DOMAIN + nonce + certificate).digest()[:4], "big") % 1_000_000
    return f"{value // 1000:03d} {value % 1000:03d}"


def pair(phone, config):
    nonce = secrets.token_bytes(32)
    response, _, _ = exchange(phone.service, {"op": "pairStart", "nonce": base64.b64encode(nonce).decode()}, timeout=config["connect_timeout"], expected_peer=phone.transport_certificate)
    pairing_id = response["pairingId"]
    code = pairing_code(nonce, phone.transport_certificate)
    print("\nCompare this number with the number shown on the phone:")
    print(f"\n    {code}\n")
    answer = input("Do all six digits match? [y/N] ").strip().lower() in {"y", "yes"}
    response, _, _ = exchange(phone.service, {"op": "pairConfirm", "pairingId": pairing_id, "matches": answer}, expected_peer=phone.transport_certificate)
    if not answer:
        fail("pairing rejected locally")
    deadline = time.monotonic() + config["pairing_timeout"]
    while response.get("state") == "waiting" and time.monotonic() < deadline:
        time.sleep(config["poll_interval"])
        response, _, _ = exchange(phone.service, {"op": "pairStatus", "pairingId": pairing_id}, expected_peer=phone.transport_certificate)
    if response.get("state") != "accepted":
        fail("pairing was rejected on the phone or timed out")
    return response["token"]


def session(phone, config):
    response, _, _ = exchange(
        phone.service,
        {"op": "session", "extensionFingerprint": phone.extension_fingerprint},
        timeout=config["connect_timeout"],
        expected_peer=phone.transport_certificate,
    )
    return response["token"]


def save_artifact(phone, token, job_id, artifact, destination, config):
    destination = Path(destination)
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(destination.name + ".part")
    print(f"Receiving {artifact} from the phone…", flush=True)
    try:
        response, _, _ = exchange(
            phone.service,
            {"op": "result", "token": token, "jobId": job_id, "artifact": artifact},
            output=temporary,
            timeout=config["signing_timeout"],
            expected_peer=phone.transport_certificate,
            max_response=(16 * 1024 * 1024 * 1024 if artifact == "extension.raw" else
                          256 * 1024 * 1024 if artifact == "boot.img" else 8 * 1024 * 1024),
        )
        os.replace(temporary, destination)
        print(f"Received {artifact} ({destination.stat().st_size} bytes).", flush=True)
        return response
    finally:
        temporary.unlink(missing_ok=True)



def boot_recovery_pairs(directory):
    return sorted((path for path in directory.glob("boot_*.img")
                   if path.is_file() and not path.is_symlink()
                   and re.fullmatch(r"boot_[A-Za-z0-9][A-Za-z0-9.+-]{0,127}_[0-9a-f]{12}\.img", path.name)
                   and path.with_suffix(".sig").is_file()
                   and not path.with_suffix(".sig").is_symlink()),
                  key=lambda path: path.stat().st_mtime_ns)


def make_boot_update_space(image, signature, directory, versioned):
    """Reserve peak staging space, reclaiming only old generated recovery pairs."""
    block = os.statvfs(directory).f_frsize or 4096
    def allocated(path):
        return ((path.stat().st_size + block - 1) // block) * block

    # Two new copies: the versioned pair and the pending active pair. The
    # previous versioned pair provides manual recovery
    required = 2 * (allocated(image) + allocated(signature)) + 1024 * 1024
    active = [directory / name for name in ("boot.img", "boot.sig")]
    for path in active:
        if path.is_symlink() or (path.exists() and not path.is_file()):
            fail(f"boot destination must be a regular file: {path}")
    active_digest = None
    if active[0].exists():
        with active[0].open("rb") as stream:
            active_digest = hashlib.file_digest(stream, "sha256").hexdigest()[:12]
    sources = {image.resolve(), signature.resolve()}
    pairs = boot_recovery_pairs(directory)
    matching_active = [path for path in pairs
                       if active_digest and path.stem.endswith("_" + active_digest)]
    protected = matching_active[-1] if matching_active else None
    candidates = [path for path in pairs
                  if path.stem != versioned
                  and path != protected
                  and path.resolve() not in sources
                  and path.with_suffix(".sig").resolve() not in sources]
    if shutil.disk_usage(directory).free >= required:
        return
    reclaimable = sum(allocated(path) + allocated(path.with_suffix(".sig")) for path in candidates)
    if shutil.disk_usage(directory).free + reclaimable < required:
        fail("Not enough ESP space for the boot update, even after pruning old recovery versions; active boot files and recovery versions were left unchanged")
    for old in candidates:
        if shutil.disk_usage(directory).free >= required:
            return
        old.with_suffix(".sig").unlink()
        old.unlink()
        os.sync()
        print(f"Removed oldest boot recovery pair to free ESP space: {old.name} / {old.with_suffix('.sig').name}; recovery requires another copy or download.")
    if shutil.disk_usage(directory).free < required:
        fail("ESP still lacks staging space after pruning; active boot files were left unchanged")


def install_boot_files(image, signature, directory, version=None):
    """Install a downloaded pair, preserving the previous pair for recovery."""
    directory = Path(directory)
    image, signature = Path(image), Path(signature)
    with image.open("rb") as stream:
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
    lines = signature.read_text("ascii").splitlines()
    if not lines or lines[0].lower() != digest:
        fail("returned boot.sig does not match the downloaded boot.img")
    if not any(line.startswith("rsa2048:") and len(line[8:].strip()) == 512
               and all(char in "0123456789abcdefABCDEF" for char in line[8:].strip())
               for line in lines[1:]):
        fail("returned boot.sig has no valid RSA-2048 signature")
    version = version or "unversioned"
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.+-]{0,127}", version):
        fail("invalid boot image version")
    versioned = f"boot_{version}_{digest[:12]}"
    with open(directory / ".extkit-boot.lock", "a+b") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        names = ("boot.img", "boot.sig")
        pending = [directory / (name + ".pending") for name in names]
        for path in pending + [directory / f"{versioned}.{suffix}" for suffix in ("img", "sig")]:
            if path.is_symlink() or (path.exists() and not path.is_file()):
                fail(f"boot destination must be a regular file: {path}")
        for path in pending:
            if path.resolve() in {image.resolve(), signature.resolve()}:
                fail("boot update input must not be a pending destination")
        for path in pending:
            if path.exists():
                path.unlink()
                print(f"Removed stale pending boot file: {path.name}; complete versioned pairs remain available for recovery.")
        make_boot_update_space(image, signature, directory, versioned)
        with tempfile.TemporaryDirectory(prefix=".extkit-boot-", dir=directory) as temporary:
            staging = Path(temporary)
            for suffix, source in (("img", image), ("sig", signature)):
                staged = staging / f"{versioned}.{suffix}"
                target = directory / staged.name
                if target.is_symlink():
                    fail(f"versioned boot destination must not be a symlink: {target}")
                shutil.copyfile(source, staged)
                with staged.open("rb") as stream:
                    os.fsync(stream.fileno())
                os.replace(staged, target)
            os.sync()
            try:
                # Copy only from the fully written versioned pair. Neither
                # active file is replaced until both pending files are flushed.
                for suffix, path in zip(("img", "sig"), pending):
                    shutil.copyfile(directory / f"{versioned}.{suffix}", path)
                    with path.open("rb") as stream:
                        os.fsync(stream.fileno())
                os.sync()
                for path, name in zip(pending, names):
                    os.replace(path, directory / name)
                os.sync()
            except OSError:
                print("ERROR: Boot installation failed. If active files are mismatched, restore a matching versioned .img/.sig pair to boot.img/boot.sig before rebooting.", file=sys.stderr)
                os.sync()
                raise
            finally:
                for path in pending:
                    path.unlink(missing_ok=True)
            # Keep the current pair plus five previous pairs.
            pairs = list(reversed(boot_recovery_pairs(directory)))
            previous = [path for path in pairs if path.stem != versioned]
            for old in previous[5:]:
                try:
                    old.unlink()
                    old.with_suffix(".sig").unlink()
                except OSError as error:
                    print(f"WARNING: Boot update is installed, but could not prune {old}: {error}", file=sys.stderr)
            os.sync()
            print(f"✓ Saved recovery pair: {versioned}.img / {versioned}.sig")


def send_request(phone, token, source, kind, output, config):
    job_id = submit_request(phone, token, source, kind, output, config)
    finish_request(phone, token, job_id, Path(source), kind, output, config)


def submit_request(phone, token, source, kind, output, config, wait=True):
    source = Path(source)
    if not source.is_file():
        fail(f"input file does not exist: {source}")
    if kind == "boot" and output is None:
        boot_directory = config["boot_directory"]
        # Trigger a systemd automount before checking the actual mount.
        boot_directory.stat()
        if not os.path.ismount(boot_directory):
            fail(f"boot partition is not mounted at {boot_directory}")
        if os.geteuid() != 0:
            fail("automatic boot installation requires root; use --output to save files elsewhere")
    deadline = time.monotonic() + config["signing_timeout"]
    while True:
        reservation, _, _ = exchange(phone.service,
            {"op": "reserve", "token": token, "kind": kind, "payloadLength": source.stat().st_size},
            expected_peer=phone.transport_certificate)
        if reservation.get("state") == "accepted":
            break
        if reservation.get("state") != "waiting":
            fail("phone returned an invalid queue reservation")
        if not wait:
            return None
        if time.monotonic() >= deadline:
            fail("timed out waiting for space in the phone's signing queue")
        print(f"Waiting for phone queue space: {source.name}", flush=True)
        time.sleep(config["poll_interval"])
    print(f"Sending {kind} signing request ({source.stat().st_size} bytes) to {phone.service.name}…", flush=True)
    response, _, _ = exchange(
        phone.service,
        {"op": "submit", "token": token, "kind": kind, "payloadLength": source.stat().st_size,
         "reservationId": reservation["reservationId"]},
        payload=source,
        timeout=config["signing_timeout"],
        expected_peer=phone.transport_certificate,
    )
    job_id = response["jobId"]
    print("Request transfer finished.", flush=True)
    print(f"Request {job_id} is awaiting review and authorization on the phone.")
    return job_id


def finish_request(phone, token, job_id, source, kind, output, config, ready=False):
    deadline = time.monotonic() + config["signing_timeout"]
    while time.monotonic() < deadline:
        if ready:
            break
        time.sleep(config["poll_interval"])
        status, _, _ = exchange(phone.service, {"op": "status", "token": token, "jobId": job_id}, expected_peer=phone.transport_certificate)
        state = status["state"]
        if state == "complete":
            break
        if state == "rejected":
            raise PhoneRequestDismissed(status.get("error") or "Request dismissed on the phone")
        if state == "failed":
            fail(status.get("error") or f"request was {state}")
    else:
        fail("timed out waiting for phone authorization")
    try:
        receive_results(phone, token, job_id, source, kind, output, config)
    except (OSError, ExtKitPhoneError, ValueError) as error:
        try:
            exchange(phone.service, {"op": "received", "token": token, "jobId": job_id,
                                    "success": False, "error": str(error)[:512]},
                     expected_peer=phone.transport_certificate)
        except (OSError, ExtKitPhoneError, ValueError):
            pass
        raise
    exchange(phone.service, {"op": "received", "token": token, "jobId": job_id,
                            "success": True}, expected_peer=phone.transport_certificate)
    print("✓ Signing and return transfer completed.", flush=True)


def send_batch(phone, token, inputs, config):
    """Upload while capacity permits, then drain results to free queue bytes."""
    remaining = list(inputs)
    pending = {}
    failures = []
    deadline = time.monotonic() + config["signing_timeout"]
    waiting_notice = False
    while remaining or pending:
        if time.monotonic() >= deadline:
            fail("batch signing timed out; returned images were retained")
        while remaining:
            path = remaining[0]
            try:
                job_id = submit_request(phone, token, path, "extension", None, config, wait=False)
            except (OSError, ExtKitPhoneError, ValueError) as error:
                print(f"✗ {path}: {error}", file=sys.stderr)
                failures.append(remaining.pop(0))
                continue
            if job_id is None:
                if not waiting_notice:
                    print("Waiting for the phone's 2 GB queue budget to become available…", flush=True)
                    waiting_notice = True
                break
            remaining.pop(0)
            pending[job_id] = path
            waiting_notice = False
        for job_id, path in list(pending.items()):
            try:
                status, _, _ = exchange(phone.service, {"op": "status", "token": token, "jobId": job_id},
                                        expected_peer=phone.transport_certificate)
                if status["state"] == "complete":
                    finish_request(phone, token, job_id, Path(path), "extension", None, config, ready=True)
                elif status["state"] == "rejected":
                    raise PhoneRequestDismissed(status.get("error") or "Dismissed on the phone")
                elif status["state"] == "failed":
                    fail(status.get("error") or "Phone signing failed")
                else:
                    continue
            except PhoneRequestDismissed as error:
                print(f"✗ {path}: {error}", file=sys.stderr)
                if sys.stdin.isatty() and input(f"Send {Path(path).name} again? [y/N] ").strip().lower() in {"y", "yes"}:
                    remaining.append(path)
                else:
                    failures.append(path)
            except (OSError, ExtKitPhoneError, ValueError) as error:
                print(f"✗ {path}: {error}", file=sys.stderr)
                failures.append(path)
            del pending[job_id]
        if remaining or pending:
            time.sleep(config["poll_interval"])
    if failures:
        fail(f"{len(failures)} signing request(s) did not complete; successfully returned images were retained")


def receive_results(phone, token, job_id, source, kind, output, config):
    if kind == "extension":
        destination = Path(output) if output else source.with_suffix(".signed.raw")
        save_artifact(phone, token, job_id, "extension.raw", destination, config)
        print(f"Saved {destination}")
    else:
        if output is not None:
            directory = Path(output)
            save_artifact(phone, token, job_id, "boot.img", directory / "personalized-boot.img", config)
            save_artifact(phone, token, job_id, "boot.sig", directory / "boot.sig", config)
            print(f"Saved {directory / 'personalized-boot.img'} and {directory / 'boot.sig'}")
        else:
            with tempfile.TemporaryDirectory(prefix="extkit-phone-result-") as temporary:
                directory = Path(temporary)
                boot_response = save_artifact(phone, token, job_id, "boot.img", directory / "boot.img", config)
                save_artifact(phone, token, job_id, "boot.sig", directory / "boot.sig", config)
                install_boot_files(directory / "boot.img", directory / "boot.sig", config["boot_directory"],
                                   version=(boot_response or {}).get("bootVersion"))
            print(f"Installed boot.img and boot.sig in {config['boot_directory']}; versioned recovery copies retained.")


def command_discover(config):
    phones, errors = find_phones(config)
    for phone in phones:
        trust = "Secure Boot db" if phone.enrolled else "not enrolled"
        print(f"{phone.service.name}\t{phone.service.address}:{phone.service.port}\t{trust}\t{phone.extension_fingerprint}")
    for error in errors:
        print(f"ignored: {error}", file=sys.stderr)
    return 0 if phones else 1


def command_boot_update(config):
    directory = config["boot_directory"]
    directory.stat()  # Trigger the ESP automount.
    if os.geteuid() != 0 or not os.path.ismount(directory):
        fail("boot-update requires root and a mounted boot partition")
    phones, errors = find_phones(config)
    for error in errors:
        print(f"ignored: {error}", file=sys.stderr)
    trusted = [phone for phone in phones if phone.enrolled]
    if not trusted:
        fail("boot-update requires a phone whose signing key is enrolled in live Secure Boot; run extkit-phone setup first")
    phone = choose_phone(trusted, "Select an enrolled phone for the boot update:")
    token = session(phone, config)
    print("Requesting the prepared signed boot image. On the phone, open Boot image update, prepare/sign an image and start the receiver.", flush=True)
    response, _, _ = exchange(phone.service, {"op": "bootUpdate", "token": token},
                             timeout=config["signing_timeout"], expected_peer=phone.transport_certificate)
    print("Prepared signed boot image is ready. Receiving the boot files…", flush=True)
    finish_request(phone, token, response["jobId"], directory / "boot.img", "boot", None, config)
    print("✓ Boot update installed. Reboot to use it.")
    return 0


def has_enrolled_user_key(config):
    return bool(enrolled_certificates(config["db_glob"], config["extension_owner"]))


def enrollment_instructions(config):
    image = config["boot_directory"] / "boot.img"
    return (
        "No ExtKit user signing key is enrolled in the live Secure Boot db.\n"
        "On your phone, open ExtSigner's 'Connect your Raspberry Pi' page.\n"
        "From 'Trusted signing': Settings gear → Connection setup.\n"
        "On 'Connect your Raspberry Pi', tap 'Start secure receiver'.\n"
        "Connect both devices to the same local network, then run as root:\n"
        f"  extkit-phone send {image} --kind boot\n"
        "Compare the six-digit code on both devices and authorize signing.\n"
        "Then reboot the Pi and run: extkit-phone check-enrollment\n"
        "If you already personalized boot.img, reboot to load its key.\n"
        "This procedure does not write OTP or change EEPROM configuration."
    )


def command_check_enrollment(config, quiet=False):
    if has_enrolled_user_key(config):
        if not quiet:
            print("ExtKit user signing key is enrolled in the live Secure Boot db.")
        return 0
    if not quiet:
        print(enrollment_instructions(config), file=sys.stderr)
    return 1


def record_pending_enrollment(phone):
    directory = PENDING_ENROLLMENT.parent
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    if directory.is_symlink() or directory.stat().st_uid != os.geteuid():
        fail("unsafe pending-enrollment directory")
    if directory.stat().st_mode & 0o077:
        fail("pending-enrollment directory must be private")
    with tempfile.NamedTemporaryFile(mode="w", encoding="ascii", dir=directory,
                                     prefix=".pending-", delete=False) as temporary:
        temporary.write(phone.extension_fingerprint + "\n")
        temporary_path = Path(temporary.name)
    try:
        temporary_path.replace(PENDING_ENROLLMENT)
    finally:
        temporary_path.unlink(missing_ok=True)


def pending_key_needs_reboot(config):
    try:
        fingerprint = PENDING_ENROLLMENT.read_text("ascii").strip()
    except (OSError, UnicodeError):
        return False
    if len(fingerprint) != 64 or any(char not in "0123456789abcdef" for char in fingerprint):
        return False
    live = {hashlib.sha256(cert).hexdigest() for cert in
            enrolled_certificates(config["db_glob"], config["extension_owner"])}
    return fingerprint not in live


def command_setup(config):
    if pending_key_needs_reboot(config):
        print("Signed boot files were installed during this boot, but the phone's key "
              "is not in the live Secure Boot db yet. Reboot to activate the key; "
              "pairing does not need to be repeated.")
        return 0
    if has_enrolled_user_key(config):
        print("Phone signing is already provisioned: an ExtKit user key is active "
              "in the live Secure Boot db. Skipping pairing.")
        return 0
    print("\nSet up your phone as an extension signer\n")
    print("On your phone, open ExtSigner's 'Connect your Raspberry Pi' page.\n"
          "From 'Trusted signing': Settings gear → Connection setup.\n"
          "On 'Connect your Raspberry Pi', tap 'Start secure receiver'.\n"
          "Connect both devices to the same local network. This wizard will find\n"
          "your phone, send boot.img for review, and install the signed files.\n"
          "Compare all six digits on both devices and approve signing on the phone.\n"
          "Reboot after firstboot finishes to activate the phone's signing key.\n"
          "This procedure does not write OTP or change EEPROM configuration.")
    while True:
        answer = input("\nSet up phone signing now? [Y/n] ").strip().lower()
        if answer not in {"", "y", "yes"}:
            print("Skipped. Extensions signed by this phone will not be trusted at boot "
                  "until enrollment and reboot.")
            return 0
        try:
            subprocess.run(["systemctl", "start", "avahi-daemon.service"], check=True)
            command_send(argparse.Namespace(
                input=str(config["boot_directory"] / "boot.img"),
                kind="boot", output=None,
            ), config)
        except PhoneRequestDismissed:
            print("Phone setup was dismissed. Run extkit-phone setup when you are ready to try again.")
            return 0
        except (ExtKitPhoneError, OSError, ValueError, KeyError,
                subprocess.CalledProcessError) as error:
            print(f"Phone setup did not complete: {error}", file=sys.stderr)
            continue
        print("\nSigned boot files installed. Reboot after firstboot finishes to load "
              "your signing key and allow its extensions to pass boot-time verification.")
        return 0


def command_send(args, config):
    phones, errors = find_phones(config)
    enrolled = [phone for phone in phones if phone.enrolled]
    if enrolled:
        phone = choose_phone(enrolled, "Multiple phones have keys enrolled in Secure Boot:")
        token = session(phone, config)
        print(f"Authenticated {phone.service.name} through the live Secure Boot db.")
    else:
        for error in errors:
            print(f"ignored: {error}", file=sys.stderr)
        phone = choose_phone(phones, "No discovered phone is enrolled; select one for initial pairing:", always_list=True)
        token = pair(phone, config)
    inputs = args.input if isinstance(args.input, list) else [args.input]
    if len(inputs) > 1:
        if args.output is not None or args.kind == "boot" or any(not str(path).endswith(".extsign") for path in inputs):
            fail("batch sending accepts only .extsign extension requests and no --output")
        if len(set(map(str, inputs))) != len(inputs):
            fail("batch contains duplicate request paths")
        print(f"Sending {len(inputs)} extension requests using one authenticated phone session.", flush=True)
        send_batch(phone, token, inputs, config)
        return 0
    args.input = inputs[0]
    kind = args.kind
    if kind == "auto":
        kind = "extension" if str(args.input).endswith(".extsign") else "boot"
    while True:
        try:
            send_request(phone, token, args.input, kind, args.output, config)
            break
        except PhoneRequestDismissed as error:
            print(f"✗ The phone dismissed the request: {error}", file=sys.stderr)
            if not sys.stdin.isatty() or input("Send the request again? [y/N] ").strip().lower() not in {"y", "yes"}:
                raise
    if kind == "boot" and args.output is None:
        try:
            record_pending_enrollment(phone)
        except (OSError, ExtKitPhoneError) as error:
            print(f"Could not save the reboot reminder: {error}. "
                  "Reboot to activate the installed signing key.", file=sys.stderr)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", default="/etc/extkit-phone.conf")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("discover", help="list visible signers and Secure Boot enrollment status")
    enrollment = commands.add_parser("check-enrollment", help="check for a user key in the live Secure Boot db")
    enrollment.add_argument("--quiet", action="store_true")
    commands.add_parser("setup", help="set up phone signing if no user key is enrolled")
    commands.add_parser("boot-update", help="retrieve the boot image already prepared and signed on the enrolled phone")
    send = commands.add_parser("send", help="send an extension request or boot.img for on-phone review")
    send.add_argument("input", nargs="+", help="one boot.img, or one or more .extsign requests")
    send.add_argument("--kind", choices=("auto", "extension", "boot"), default="auto")
    send.add_argument("--output", help="finished GPT image path for extensions; save boot files here instead of installing them on the boot partition")
    args = parser.parse_args(argv)
    config = load_config(args.config)
    if args.command == "discover":
        return command_discover(config)
    if args.command == "check-enrollment":
        return command_check_enrollment(config, args.quiet)
    if args.command == "setup":
        return command_setup(config)
    if args.command == "boot-update":
        return command_boot_update(config)
    return command_send(args, config)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ExtKitPhoneError, OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        print(f"✗ extkit-phone: {error}", file=sys.stderr)
        raise SystemExit(1)
