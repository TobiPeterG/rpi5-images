#!/usr/bin/python3
"""Send artifacts to the owner's phone for independent review and signing."""
from pathlib import Path
import sys
import subprocess
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from extkit.phone_cli import main
from extkit.errors import ExtkitError
if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ExtkitError, OSError, subprocess.SubprocessError) as error:
        from extkit.console import print
        print(f"✗ extkit-phone: {error}", file=sys.stderr, color="red")
        raise SystemExit(1)
