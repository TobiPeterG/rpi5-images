[Transfer]
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=https://download.opensuse.org/repositories/home:/Tobi_Peter:/rpi5_microos_sb/mkosi/
MatchPattern=%M_@v_%a.root-%a-verity-@u.raw.xz

[Target]
Type=partition
Path=auto
MatchPattern=%M_@v
MatchPartitionType=root-verity
PartitionFlags=0
ReadOnly=yes
InstancesMax=2
