[Transfer]
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=https://download.opensuse.org/repositories/home:/Tobi_Peter:/rpi5_microos_sb/mkosi/
MatchPattern=%M_@v_%a.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=%M_@v_%a+@l-@d.efi \
             %M_@v_%a+@l.efi \
             %M_@v_%a.efi
Mode=0644
TriesLeft=3
TriesDone=0
InstancesMax=2
