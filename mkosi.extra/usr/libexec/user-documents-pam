#!/usr/bin/bash -p
# Request home setup before pam_systemd starts the user manager.
set -u
source /usr/libexec/user-documents-common

fail() {
    local message="user-documents-pam: $*"
    printf '%s\n' "$message"
    printf '%s\n' "$message" | /usr/bin/systemd-cat -t user-documents-pam -p err || :
    exit 1
}

# user@UID.service requires the unit before its systemd-user PAM session.
[[ ${PAM_SERVICE:-} != systemd-user ]] || exit 0
username=${PAM_USER:-}
[[ -n $username && $username != */* && $username != *$'\n'* ]] || fail 'invalid PAM user'
load_account "$username" || fail 'cannot resolve the PAM account or its UID is shared'
[[ $account_name == "$username" ]] || fail 'account lookup did not return the requested user'
has_documents_home || exit 0
if ! output=$(/usr/bin/env -i PATH=/usr/sbin:/usr/bin SYSTEMD_PAGER=cat /usr/bin/systemctl start "user-documents-setup@${account_uid}.service" 2>&1); then
    fail "cannot prepare Documents for ${account_name}: ${output}. See journalctl -b -u user-documents-setup@${account_uid}.service"
fi
