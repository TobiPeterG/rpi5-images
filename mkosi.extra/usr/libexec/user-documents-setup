#!/usr/bin/bash -p
# Create a volatile home and link persistent user storage for one UID.
set -euo pipefail
umask 077
source /usr/libexec/user-documents-common

fail() { printf 'Cannot prepare user home: %s\n' "$*" >&2; exit 1; }
uid=${1:-}
[[ $uid =~ ^[0-9]+$ ]] || fail 'expected a numeric UID'
load_account "$uid" || fail "cannot resolve UID $uid"
[[ $account_uid == "$uid" ]] || fail 'UID lookup mismatch'
has_documents_home || exit 0

findmnt -rn --mountpoint /.state >/dev/null || fail '/.state is not mounted'

# The root-owned lock serializes concurrent home/storage creation.
[[ ! -L /run/user-documents-setup.lock ]] || fail 'unsafe setup lock'
exec {lock_fd}>>/run/user-documents-setup.lock
[[ -f /proc/self/fd/$lock_fd && $(stat -Lc '%u %a' "/proc/self/fd/$lock_fd") == '0 600' ]] || fail 'unsafe setup lock'
flock -x "$lock_fd"

# Open verified directory descriptors.
open_dir() {
    local parent=$1 name=$2 owner=$3 group=$4 mode=$5 path expected actual details got_uid got_gid got_mode
    [[ -n $name && $name != . && $name != .. && $name != */* ]] || fail 'invalid directory name'
    path="/proc/self/fd/$parent/$name"
    [[ ! -L $path ]] || fail "symlinked directory: $name"
    if [[ ! -e $path ]]; then
        mkdir -m "$mode" -- "$path" || fail "cannot create $name"
        chown -h "$owner:$group" -- "$path" || fail "cannot set owner on $name"
    fi
    [[ -d $path && ! -L $path ]] || fail "invalid directory: $name"
    exec {opened_fd}<"$path" || fail "cannot open $name"
    expected=$(readlink -f -- "/proc/self/fd/$parent")
    expected=${expected%/}/$name
    actual=$(readlink -f -- "/proc/self/fd/$opened_fd")
    [[ $actual == "$expected" ]] || fail "directory changed during setup: $name"
    details=$(stat -Lc '%u %g %a' "/proc/self/fd/$opened_fd") || fail "cannot inspect $name"
    read -r got_uid got_gid got_mode <<< "$details"
    [[ $got_uid == "$owner" && $got_gid == "$group" && $got_mode =~ ^[0-7]+$ ]] || fail "unsafe ownership on $name"
    (( (8#$got_mode & 8#022) == 0 )) || fail "unsafe permissions on $name"
}

[[ -d /.state && ! -L /.state && -d /home && ! -L /home ]] || fail 'invalid mount directories'
exec {state_fd}</.state
exec {homes_fd}</home
open_dir "$state_fd" documents 0 0 0711; documents_fd=$opened_fd
chmod 0711 "/proc/self/fd/$documents_fd" || fail 'cannot allow storage traversal'
created_home=no
if [[ $account_name == root ]]; then
    exec {parent_fd}</
    home_name=root
else
    exec {parent_fd}<&"$homes_fd"
    home_name=${account_home#/home/}
    if [[ ! -e $account_home && ! -L $account_home ]]; then
        # The helper merges vendor defaults beneath the local skeleton
        vendor_skeleton=()
        [[ ! -d /usr/etc/skel ]] || vendor_skeleton=(/usr/etc/skel)
        /usr/bin/env -i PATH=/usr/sbin:/usr/bin /usr/sbin/mkhomedir_helper \
            "$account_name" 0077 /etc/skel 0700 "${vendor_skeleton[@]}" || fail 'cannot create home from skeleton'
        restorecon -RF -- "$account_home" || fail 'cannot label home skeleton'
        created_home=yes
    fi
fi
[[ -e $account_home || -L $account_home ]] || created_home=yes
open_dir "$parent_fd" "$home_name" "$account_uid" "$account_gid" 0700; home_fd=$opened_fd
open_dir "$documents_fd" "$account_uid" "$account_uid" "$account_gid" 0700; source_fd=$opened_fd
restorecon -F -- /.state/documents "/.state/documents/$account_uid" || fail 'cannot label persistent storage'

persistent="/proc/self/fd/$home_fd/Persistent"
# Only skeleton-created homes carry this placeholder
if [[ -L $persistent && $(readlink -- "$persistent") == '/.state/documents/@UID@' ]]; then
    rm -- "$persistent" || fail 'cannot replace Persistent template'
    created_home=yes
fi
if [[ $created_home == yes ]]; then
    if [[ ! -e $persistent && ! -L $persistent ]]; then
        ln -s -- "/.state/documents/$account_uid" "$persistent" || fail 'cannot create Persistent link'
        chown -h "$account_uid:$account_gid" "$persistent" || fail 'cannot set Persistent link owner'
        restorecon -F -- "$account_home/Persistent" || fail 'cannot label Persistent link'
    fi
    exec {run_fd}</run
    open_dir "$run_fd" user-home-setup 0 0 0755; markers_fd=$opened_fd
    marker="/proc/self/fd/$markers_fd/$account_uid.created"
    [[ ! -L $marker ]] || fail 'unsafe home creation marker'
    : >"$marker"
    chmod 0644 "$marker"
fi
printf '%s: %s (persistent storage: /.state/documents/%s)\n' "$account_name" "$account_home" "$account_uid"
