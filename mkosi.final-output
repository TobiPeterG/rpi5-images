#!/usr/bin/bash
set -euo pipefail

# This is run as the final build script of the second mkosi-obs stage, after OBS
# signatures have been attached and the final disk image has been reconstructed.
# Build scripts do not receive OUTPUTDIR; mkosi-obs writes its results below the
# source tree.
output_dir=${OUTPUTDIR:-${SRCDIR:?}/usr/src/packages/OTHER}
source_dir=${OBS_SOURCES_DIR:-/usr/src/packages/SOURCES}

shopt -s nullglob
disks=("${output_dir}"/*_"${IMAGE_VERSION}"_"${ARCHITECTURE}".raw)
(( ${#disks[@]} > 0 )) || {
    echo "No final signed raw disk images found for ${IMAGE_VERSION}/${ARCHITECTURE}" >&2
    exit 1
}

for disk in "${disks[@]}"; do
    # mkosi-obs only carries files matching the last image ID into the
    # signing stage. Preserve the buildroot RPM of each image as well.
    disk_name=${disk##*/}
    image=${disk_name%_${IMAGE_VERSION}_${ARCHITECTURE}.raw}
    rpm_sources=("${source_dir}"/"${image}"-buildroot-"${IMAGE_VERSION}"-*.rpm)
    (( ${#rpm_sources[@]} == 1 )) || {
        printf 'Expected one buildroot RPM for %s, found %d\n' "${image}" "${#rpm_sources[@]}" >&2
        exit 1
    }
    rpm_output=${output_dir}/${rpm_sources[0]##*/}
    [[ -f ${rpm_output} ]] || install -m 0644 "${rpm_sources[0]}" "${rpm_output}"
    boot=${disk%.raw}.boot.img
    # mkosi-obs copies IMAGE_ID* from the first stage, but a multi-image build
    # also needs the other variant's original factory boot image. OBS exposes
    # all first-stage artifacts in SOURCES; preserve that file unchanged.
    if [[ ! -s ${boot} ]]; then
        install -m 0644 "${source_dir}/${boot##*/}" "${boot}"
    fi
    [[ -s ${boot} ]] || {
        echo "Original factory boot.img artifact not found: ${boot}" >&2
        exit 1
    }
    xz --threads=0 --keep --force "${disk}"
done
