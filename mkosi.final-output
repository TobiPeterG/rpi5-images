#!/usr/bin/bash
set -euo pipefail

# This is run as the final build script of the second mkosi-obs stage, after OBS
# signatures have been attached and the final disk image has been reconstructed.
# Build scripts do not receive OUTPUTDIR; mkosi-obs writes its results below the
# source tree.
output_dir=${OUTPUTDIR:-${SRCDIR:?}/usr/src/packages/OTHER}

shopt -s nullglob
disks=("${output_dir}"/*_"${IMAGE_VERSION}"_"${ARCHITECTURE}".raw)
(( ${#disks[@]} > 0 )) || {
    echo "No final signed raw disk images found for ${IMAGE_VERSION}/${ARCHITECTURE}" >&2
    exit 1
}

for disk in "${disks[@]}"; do
    xz --threads=0 --keep --force "${disk}"
done
