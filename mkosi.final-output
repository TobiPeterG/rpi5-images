#!/usr/bin/bash
set -euo pipefail

# This is run by the second mkosi-obs stage, after OBS signatures have been
# attached and the final disk image has been reconstructed.
shopt -s nullglob
disks=("${OUTPUTDIR}"/*_"${IMAGE_VERSION}"_"${ARCHITECTURE}".raw)
(( ${#disks[@]} > 0 )) || {
    echo "No final signed raw disk images found for ${IMAGE_VERSION}/${ARCHITECTURE}" >&2
    exit 1
}

for disk in "${disks[@]}"; do
    xz --threads=0 --keep --force "${disk}"
    (
        cd "${OUTPUTDIR}"
        sha256sum "$(basename "${disk}.xz")" > "$(basename "${disk}.xz").sha256"
    )
done
