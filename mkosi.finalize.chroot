#!/usr/bin/bash
set -euo pipefail

[[ ${ARCHITECTURE:?} == arm64 ]] || {
    echo "This image is only supported for arm64" >&2
    exit 1
}

# openSUSE MicroOS currently publishes SYSEXT_LEVEL but no CONFEXT_LEVEL.
if ! grep -q '^CONFEXT_LEVEL=' /usr/lib/os-release; then
    printf '\nCONFEXT_LEVEL=microos-confext-1\n' >> /usr/lib/os-release
fi
install -d -m 0755 /home /var/log /var/lib/extensions /var/lib/confexts
install -d -m 0700 /.overlay
install -d -m 0700 /.overlay/upper

# mkosi discovers kernels below /usr/lib/modules, while openSUSE installs the
# arm64 boot image below /boot and leaves only vmlinux.xz in the module tree.
# Expose the bootable image where mkosi expects it so it does not mistake the
# ELF vmlinux archive for a PE-signable kernel image.
shopt -s nullglob
for modules_dir in /usr/lib/modules/*; do
    [[ -d ${modules_dir} ]] || continue
    [[ -e ${modules_dir}/vmlinuz ]] && continue

    kernel_version=${modules_dir##*/}
    kernel_image=
    for candidate in "/boot/vmlinuz-${kernel_version}" "/boot/Image-${kernel_version}"; do
        if [[ -f ${candidate} ]]; then
            kernel_image=${candidate}
            break
        fi
    done

    [[ -n ${kernel_image} ]] || {
        echo "Bootable kernel image not found for ${kernel_version}" >&2
        exit 1
    }

    cp --reflink=auto --preserve=mode,timestamps "${kernel_image}" "${modules_dir}/vmlinuz"
done

# Firmware RPMs require dracut for installation-time scriptlets. Keep their
# firmware files, but omit the unused initrd generator from the final image.
# Dependency-resolving removal would uninstall the firmware as well.
if rpm -q dracut >/dev/null 2>&1; then
    rpm -e --nodeps dracut
fi
