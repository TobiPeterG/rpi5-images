#!/usr/bin/bash
set -euo pipefail

# The top-level mkosi-obs include cannot propagate its non-inheritable
# post-output script into dependency images. Including all of mkosi-obs in a
# dependency image is invalid because it also contains main-image-only
# settings.
obs_build=false
source_dir=${SRCDIR:?}
if [[ -s /usr/src/packages/SOURCES/_projectcert.crt ]]; then
    obs_build=true

    # OBS invokes mkosi with --directory, but SRCDIR still refers to mkosi's
    # /work/src sandbox directory rather than the extracted package sources.
    source_dir=
    for candidate in /usr/src/packages/SOURCES/*; do
        if [[ -f ${candidate}/mkosi.postoutput && -f ${candidate}/mkosi.final-output ]]; then
            source_dir=${candidate}
            break
        fi
    done
    [[ -n ${source_dir} ]] || {
        echo "mkosi source tree containing mkosi.final-output not found" >&2
        exit 1
    }

    obs_postoutput=$(python3 -c 'import importlib.resources; print(importlib.resources.files("mkosi") / "resources" / "mkosi-obs" / "mkosi.postoutput")')
    [[ -f ${obs_postoutput} ]] || {
        echo "mkosi-obs post-output helper not found: ${obs_postoutput}" >&2
        exit 1
    }
    /usr/bin/bash "${obs_postoutput}"
fi

# Keep producing a desync index for the independently published EROFS root
# partition.
shopt -s nullglob
roots=("$OUTPUTDIR"/"$IMAGE_ID"_"$IMAGE_VERSION"_"$ARCHITECTURE".root-"$ARCHITECTURE"-[[:xdigit:]]*.raw)
verities=("$OUTPUTDIR"/"$IMAGE_ID"_"$IMAGE_VERSION"_"$ARCHITECTURE".root-"$ARCHITECTURE"-verity-*.raw)

if (( ${#roots[@]} != 1 )); then
    printf 'Expected one split EROFS root artifact for %s, found %d\n' \
        "$IMAGE_ID" "${#roots[@]}" >&2
    printf 'Candidates: %s\n' "${roots[*]:-<none>}" >&2
    exit 1
fi

if (( ${#verities[@]} != 1 )); then
    printf 'Expected one split root verity artifact for %s, found %d\n' \
        "$IMAGE_ID" "${#verities[@]}" >&2
    printf 'Candidates: %s\n' "${verities[*]:-<none>}" >&2
    exit 1
fi

desync make --chunk-size 1024:2048:4096 "${roots[0]}.caibx" "${roots[0]}"

# The mkosi checksum file is generated before post-output scripts run, so
# create a checksum for the additional delta file here.
(
    cd "$OUTPUTDIR"
    sha256sum "$(basename "${roots[0]}.caibx")" > "$(basename "${roots[0]}.caibx").sha256"
)

# support download compressed copies of the fixed-size slots.
for artifact in "${roots[0]}" "${verities[0]}"; do
    xz --threads=0 --keep --force "${artifact}"
    (
        cd "$OUTPUTDIR"
        sha256sum "$(basename "${artifact}.xz")" > "$(basename "${artifact}.xz").sha256"
    )
done


# In OBS, mkosi-obs creates a second-stage mkosi.conf that attaches the OBS
# signatures to the UKI, bootloader and verity metadata. Compressing the disk
# here would preserve the pre-signing disk and publish it alongside the final
# raw image. Add a post-output helper to that generated recipe instead, so the
# flashable XZ image is made only after all signatures have been attached.
disk="$OUTPUTDIR/${IMAGE_ID}_${IMAGE_VERSION}_${ARCHITECTURE}.raw"

if [ ! -f "$disk" ]; then
    printf 'Expected complete raw disk image not found: %s\n' "$disk" >&2
    exit 1
fi

if [[ ${obs_build} == true ]]; then
    recipe=${OUTPUTDIR}/mkosi.conf
    [[ -f ${recipe} ]] || {
        echo "mkosi-obs did not create its second-stage recipe before mkosi.postoutput" >&2
        exit 1
    }

    install -m 0755 "${source_dir}/mkosi.final-output" "${OUTPUTDIR}/mkosi.final-output"
    cat >> "${recipe}" <<'EOF'

[Content]
PostOutputScripts=%D/mkosi.final-output
EOF
else
    xz --threads=0 --keep --force "$disk"

    # The mkosi checksum file is generated before post-output scripts run, so
    # create a checksum for the additional compressed disk image here.
    (
        cd "$OUTPUTDIR"
        sha256sum "$(basename "${disk}.xz")" > "$(basename "${disk}.xz").sha256"
    )
fi
