[oss]
name=openSUSE Tumbleweed ARM OSS
enabled=1
autorefresh=0
baseurl=https://download.opensuse.org/ports/aarch64/tumbleweed/repo/oss/
type=rpm-md
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://download.opensuse.org/ports/aarch64/tumbleweed/repo/oss/repodata/repomd.xml.key

[oss-update]
name=openSUSE Tumbleweed ARM Updates
enabled=1
autorefresh=0
baseurl=https://download.opensuse.org/ports/aarch64/update/tumbleweed/
type=rpm-md
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://download.opensuse.org/ports/aarch64/update/tumbleweed/repodata/repomd.xml.key

[rpi5_microos_sb]
name=Raspberry Pi 5 MicroOS Secure Boot packages
enabled=1
autorefresh=0
baseurl=https://download.opensuse.org/repositories/home:/Tobi_Peter:/rpi5_microos_sb/openSUSE_Tumbleweed/
